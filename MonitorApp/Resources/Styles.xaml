<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Header Button Style -->
    <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="45"/>
        <Setter Property="Width" Value="90"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F9FAFB"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Toggle Button Style -->
    <Style x:Key="ViewToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#6B9EF5"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F0F0"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#7AABF7"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Icon Style -->
    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="Stroke" Value="#666666"/>
    </Style>

    <Style x:Key="IconRectangleStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="#666666"/>
    </Style>


    <!-- Toggle Container -->
    <Style x:Key="ToggleContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Padding" Value="5"/>
    </Style>


    <!-- Navigation Button Style -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border" 
                            Background="Transparent" 
                            Padding="20,10"
                            CornerRadius="8"
                            Margin="5,0">

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <ContentPresenter Content="{TemplateBinding Tag}" 
                                              Margin="0,0,8,0"/>

                            <TextBlock x:Name="titleText"
                                       Text="{TemplateBinding Content}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#666666"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E8F4FD"/>
                            <Setter TargetName="titleText" Property="Foreground" Value="#2196F3"/>
                            <Setter TargetName="titleText" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Badge -->
    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#F44336"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Margin" Value="-8,-10,0,0"/>
    </Style>


    <!-- Upgrade Button -->
    <Style x:Key="UpgradeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#00BCD4"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#00ACC1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- GlassWire Toggle Container -->
    <Style x:Key="GW_ToggleContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BorderBrush" Value="#E5EAF0"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- GlassWire Toggle Button Style -->
    <Style x:Key="GW_ToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="68"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Khi được chọn -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background" Value="#4D8CFD"/>
                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background">
                                <Setter.Value>#E6EEFF</Setter.Value>
                            </Setter>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Path Style (Wave icon) -->
    <Style x:Key="GW_ToggleIconPath" TargetType="Path">
        <Setter Property="Stroke" Value="#6D7B8C"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Stroke" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Rectangle Style (Grid icon) -->
    <Style x:Key="GW_ToggleIconRect" TargetType="Rectangle">
        <Setter Property="Fill" Value="#6D7B8C"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Fill" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Rounded ComboBox -->
    <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="130"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">

                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>

                            <Path Data="M6 9l6 6 6-6" 
                                  Stroke="#666666" StrokeThickness="2"
                                  HorizontalAlignment="Right"
                                  Margin="0,0,12,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= TOGGLE 2 NỬA (WAVE / GRID+GLOBE) ========= -->

    <!-- Viên thuốc chứa 2 nửa -->
    <Style x:Key="GW_2SegmentContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderBrush" Value="#E5EAF0"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Base style cho mỗi nửa (ToggleButton) -->
    <Style x:Key="GW_SegmentToggleBaseStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- Tag dùng để truyền CornerRadius khác nhau cho 2 nửa -->
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding Tag}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Nửa được chọn: nền xanh -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="#4D8CFD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Path (wave / globe) đổi màu theo IsChecked của Toggle cha -->
    <Style x:Key="GW_SegmentIconPath" TargetType="Path">
        <Setter Property="Stroke" Value="#6D7B8C"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked,
                                           RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                         Value="True">
                <Setter Property="Stroke" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Rectangle (grid) đổi màu theo IsChecked -->
    <Style x:Key="GW_SegmentIconRect" TargetType="Rectangle">
        <Setter Property="Fill" Value="#6D7B8C"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked,
                                           RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                         Value="True">
                <Setter Property="Fill" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
