<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Header Button Style -->
    <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="90"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#666666" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F9FAFB"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Toggle Button Style -->
    <Style x:Key="ViewToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#6B9EF5"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#F0F0F0"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#7AABF7"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Icon Style -->
    <Style x:Key="IconPathStyle" TargetType="Path">
        <Setter Property="Stroke" Value="#666666"/>
    </Style>

    <Style x:Key="IconRectangleStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="#666666"/>
    </Style>


    <!-- Toggle Container -->
    <Style x:Key="ToggleContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Padding" Value="5"/>
    </Style>


    <!-- Navigation Button Style -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <!-- Màu mặc định (chưa chọn) -->
        <Setter Property="Foreground" Value="#666666" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                          Background="Transparent"
                          Padding="20,10"
                          CornerRadius="8"
                          Margin="5,0">

                        <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Height="30">

                            <ContentPresenter Content="{TemplateBinding Tag}"
                                            Margin="0,0,0,0" />

                            <TextBlock x:Name="titleText"
                                     Text="{TemplateBinding Content}"
                                     FontSize="10"
                                     FontWeight="Medium"
                                     Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border"
                                  Property="Background"
                                  Value="#F5F5F5" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border"
                                  Property="Background"
                                  Value="#E8F4FD" />
                            <!-- Đổi màu chung cho RadioButton (text + icon bind theo) -->
                            <Setter Property="Foreground" Value="#3D6FEA" />
                            <Setter TargetName="titleText"
                                  Property="FontWeight"
                                  Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Badge -->
    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#F44336"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Margin" Value="-8,-10,0,0"/>
    </Style>


    <!-- Upgrade Button -->
    <Style x:Key="UpgradeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#00BCD4"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#00ACC1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- GlassWire Toggle Container -->
    <Style x:Key="GW_ToggleContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BorderBrush" Value="#E5EAF0"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- GlassWire Toggle Button Style -->
    <Style x:Key="GW_ToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="68"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="20"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">

                        <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- Khi được chọn -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background" Value="#4D8CFD"/>
                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Background">
                                <Setter.Value>#E6EEFF</Setter.Value>
                            </Setter>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Path Style (Wave icon) -->
    <Style x:Key="GW_ToggleIconPath" TargetType="Path">
        <Setter Property="Stroke" Value="#6D7B8C"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Stroke" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Rectangle Style (Grid icon) -->
    <Style x:Key="GW_ToggleIconRect" TargetType="Rectangle">
        <Setter Property="Fill" Value="#6D7B8C"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Fill" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Rounded ComboBox -->
    <!-- Rounded ComboBox - ĐÃ SỬA, CLICK MƯỢT 100% -->
    <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#666666" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggleButton"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Background="{TemplateBinding Background}"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate>
                                    <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="20">
                                        <Grid>
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="#666666"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,16,0"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom"
                           Focusable="False">
                            <Border Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="8"
                                MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= TOGGLE 2 NỬA (WAVE / GRID+GLOBE) ========= -->

    <!-- Viên thuốc chứa 2 nửa -->
    <Style x:Key="GW_2SegmentContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderBrush" Value="#E5EAF0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Base style cho mỗi nửa (ToggleButton) -->
    <Style x:Key="GW_SegmentToggleBaseStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- Tag dùng để truyền CornerRadius khác nhau cho 2 nửa -->
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding Tag}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Nửa được chọn: nền xanh -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg"
                                    Property="Background"
                                    Value="#4D8CFD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Path (wave / globe) đổi màu theo IsChecked của Toggle cha -->
    <Style x:Key="GW_SegmentIconPath" TargetType="Path">
        <Setter Property="Stroke" Value="#6D7B8C"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked,
                                           RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                         Value="True">
                <Setter Property="Stroke" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Rectangle (grid) đổi màu theo IsChecked -->
    <Style x:Key="GW_SegmentIconRect" TargetType="Rectangle">
        <Setter Property="Fill" Value="#6D7B8C"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked,
                                           RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                         Value="True">
                <Setter Property="Fill" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Style cho Border biểu đồ -->
    <Style x:Key="ChartBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="0,10,0,5"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#E0E0E0" 
                                Direction="270" 
                                ShadowDepth="2" 
                                BlurRadius="10" 
                                Opacity="0.5"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style cho Border timeline -->
    <Style x:Key="TimelineBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <!-- BỎ Width cố định đi -->
        <!-- <Setter Property="Width" Value="1500"/> -->
        <!-- Thêm stretch để luôn full ngang -->
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>


    <!-- Style cho các đường biểu đồ -->
    <Style x:Key="ChartLineStyle" TargetType="Polyline">
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" 
                                Direction="270" 
                                ShadowDepth="1" 
                                BlurRadius="8" 
                                Opacity="0.2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style cho Grid Lines -->
    <Style x:Key="GridLinesStyle" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Line X1="0" Y1="0" X2="2000" Y2="0" 
                          Stroke="#F0F0F0" 
                          StrokeThickness="1"
                          StrokeDashArray="4,4"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style cho Time Labels -->
    <Style x:Key="TimeLabelsStyle" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="150">
                        <!-- Chiều rộng cố định --> 
                        <!-- Vạch dọc -->
                        <Rectangle Width="1" 
                              Height="4" 
                              Fill="#CCCCCC"
                              HorizontalAlignment="Center"/>
                        <!-- Nhãn thời gian -->
                        <TextBlock Text="{Binding}" 
                              FontSize="10" 
                              FontFamily="Segoe UI"
                              Foreground="#999999"
                              FontWeight="Normal"
                              TextAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="0,4,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Style cho Legend Panel -->
    <Style x:Key="LegendPanelStyle" TargetType="StackPanel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#E0E0E0" 
                                Direction="270" 
                                ShadowDepth="1" 
                                BlurRadius="8" 
                                Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style cho Value Text -->
    <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#333333"/>
    </Style>

    <!-- Animation cho đường biểu đồ -->
    <Storyboard x:Key="LineEntryAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="0" To="1" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Column Border Style -->
    <Style x:Key="UsageColumnBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <!-- Column Header Style -->
    <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="Margin" Value="16,12,16,12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- ScrollViewer Style -->
    <Style x:Key="UsageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ItemsControl Style -->
    <Style x:Key="UsageItemsControlStyle" TargetType="ItemsControl">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Item Border Style -->
    <Style x:Key="UsageItemBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F3F4F6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Item Icon Style -->
    <Style x:Key="ItemIconStyle" TargetType="Image">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- Item Flag Style -->
    <Style x:Key="ItemFlagStyle" TargetType="Image">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stretch" Value="Fill"/>
    </Style>

    <!-- Item Name Style -->
    <Style x:Key="ItemNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- Item Size Style -->
    <Style x:Key="ItemSizeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- Progress Bar Style -->
    <Style x:Key="UsageProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="3"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EC4899" Offset="0"/>
                    <GradientStop Color="#F472B6" Offset="0.5"/>
                    <GradientStop Color="#FBBF24" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" 
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               CornerRadius="2"/>
                        <Border x:Name="PART_Track" 
                               Background="Transparent"
                               CornerRadius="2">
                            <Border x:Name="PART_Indicator"
                                   Background="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Left"
                                   CornerRadius="2"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- More Button Style -->
    <Style x:Key="MoreButtonStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F3F4F6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MoreButtonTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Footer Border Style -->
    <Style x:Key="FooterBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="20,0"/>
    </Style>

    <!-- Side Value Style (629.1 KB, 1.8 MB) -->
    <Style x:Key="SideValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#4B5563"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Side Speed Style (71 B/s, 69 B/s) -->
    <Style x:Key="SideSpeedStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#9CA3AF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Center Total Style (2.4 MB - tổng) -->
    <Style x:Key="CenterTotalStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Network Label Style (WAN/LAN) -->
    <Style x:Key="NetworkLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Network Size Style (2.4 MB, 36 KB) -->
    <Style x:Key="NetworkSizeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <!-- Network Bar Border Style -->
    <Style x:Key="NetworkBarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#F3F4F6"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- Network Bar Fill Style -->
    <Style x:Key="NetworkBarFillStyle" TargetType="Border">
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- COLORS -->
    <SolidColorBrush x:Key="HeaderBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="RowBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowAltBg" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="BorderGray" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TextDark" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextLight" Color="#64748B"/>

    <!-- Allowed / Blocked Tags -->
    <Style x:Key="TagBase" TargetType="Border">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <Style x:Key="TagAllowed" TargetType="Border" BasedOn="{StaticResource TagBase}">
        <Setter Property="Background" Value="#DCFCE7"/>
        <Setter Property="BorderBrush" Value="#86EFAC"/>
    </Style>

    <Style x:Key="TagBlocked" TargetType="Border" BasedOn="{StaticResource TagBase}">
        <Setter Property="Background" Value="#FEE2E2"/>
        <Setter Property="BorderBrush" Value="#FCA5A5"/>
    </Style>


    <!-- ============= GLOBAL BRUSHES ============= -->

    <SolidColorBrush x:Key="ColorBorderLight" Color="#D2D7E4"/>
    <SolidColorBrush x:Key="ColorBorderTable" Color="#E1E5F0"/>
    <SolidColorBrush x:Key="ColorRowAlt" Color="#FAFBFE"/>
    <SolidColorBrush x:Key="ColorRowSelected" Color="#E3F2FD"/>
    <SolidColorBrush x:Key="ColorHeaderBg" Color="#F5F7FB"/>

    <!-- ============= OPTIONAL TEXT STYLE ============= -->

    <Style x:Key="TableHeaderText"
           TargetType="TextBlock">
        <Setter Property="Foreground" Value="#777"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============= DATA GRID HEADER ============= -->

    <Style x:Key="TableColumnHeaderStyle"
           TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource ColorHeaderBg}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorderTable}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#777"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- ============= DATA GRID ROW (FIX LỖI) ============= -->
    <!-- KHÔNG dùng Setter cho AlternationIndex nữa,
         chỉ dùng Trigger trên ItemsControl.AlternationIndex -->

    <Style x:Key="TableRowStyle"
           TargetType="DataGridRow">
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
            <!-- Hàng xen kẽ -->
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background"
                        Value="{StaticResource ColorRowAlt}"/>
            </Trigger>

            <!-- Hàng được chọn -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"
                        Value="{StaticResource ColorRowSelected}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============= SEARCH BOX BORDER ============= -->

    <Style x:Key="SearchBoxBorder"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorderLight}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Height" Value="32"/>
    </Style>

    <!-- ============= DROPDOWN BORDER ============= -->

    <Style x:Key="DropdownBorder"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorderLight}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinWidth" Value="220"/>
    </Style>

    <!-- ============= TOGGLE BUTTON ============= -->

    <Style x:Key="ToggleSwitchStyle"
           TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SwitchBackground"
                            CornerRadius="9"
                            Background="#D3D8E5">
                        <Grid Margin="1">
                            <Ellipse x:Name="Knob"
                                     Width="16" Height="16"
                                     Fill="White"
                                     HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchBackground"
                                    Property="Background"
                                    Value="#4CAF50"/>
                            <Setter TargetName="Knob"
                                    Property="HorizontalAlignment"
                                    Value="Right"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
