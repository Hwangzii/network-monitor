<Window x:Class="MonitorApp.Views.StartWindow.SW_Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Network Monitor"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#E4F4F7">
   
    <Grid>
        <!-- căn giữa toàn bộ nội dung -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextOptions.TextFormattingMode="Display"
                    TextOptions.TextRenderingMode="Grayscale"
                    TextOptions.TextHintingMode="Fixed">

            <!-- Logo -->
            <Image Source="/Resources/Icons/Logo2.png"
                   Width="90" Height="90"
                   Stretch="Uniform"
                   Margin="0,0,0,18"/>

            <!-- NHÓM 5 - LỚP 22CN1 -->
            <TextBlock Text="NHÓM 5 - LỚP 22CN1"
                       FontSize="40"
                       FontWeight="SemiBold"
                       Foreground="#222222"
                       TextAlignment="Center"
                       Margin="0,0,0,6"/>

            <!-- Môn học -->
            <TextBlock Text="Môn học: Lập trình mạng"
                       FontSize="25"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       TextAlignment="Center"
                       Margin="0,0,0,2"/>

            <!-- Khoa / Trường -->
            <TextBlock Text="Khoa Công nghệ Thông tin – Trường Đại học Kiến trúc Hà Nội"
                       FontSize="20"
                       Foreground="#777777"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
