<Window x:Class="MonitorApp.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layouts="clr-namespace:MonitorApp.Views.Layouts"
        Title="Network Monitor"
        Height="680" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header: chiều cao tự động theo nội dung -->
            <RowDefinition Height="Auto"/>
            <!-- MainContent: chiếm hết phần còn lại -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <layouts:Header Grid.Row="0" 
                        Loaded="Header_Loaded"/>

        <!-- MainContent: dính sát dưới Header và fill hết -->
        <layouts:MainContent Grid.Row="1" 
                             Loaded="MainContent_Loaded"/>
    </Grid>
</Window>