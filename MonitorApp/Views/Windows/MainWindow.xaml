<Window x:Class="MonitorApp.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layouts="clr-namespace:MonitorApp.Views.Layouts"
        xmlns:vm="clr-namespace:MonitorApp.ViewModels"
        Title="Network Monitor" 
        MinHeight="700" MinWidth="1000"
        Background="White"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header: chiều cao tự động theo nội dung -->
            <RowDefinition Height="Auto"/>
            <!-- MainContent: chiếm hết phần còn lại -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <layouts:Header Grid.Row="0" Loaded="Header_Loaded"/>

        <!-- MainContent -->
        <layouts:MainContent Grid.Row="1" Loaded="MainContent_Loaded"/>
    </Grid>
</Window>