<Window x:Class="MonitorApp.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layouts="clr-namespace:MonitorApp.Views.Layouts"
        xmlns:vm="clr-namespace:MonitorApp.ViewModels"
        Title="Network Monitor" 
        Height="680" Width="1200"
        Background="White"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- Header chiếm 2 phần -->
            <RowDefinition Height="1*"/>
            <!-- MainContent chiếm 8 phần -->
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <layouts:Header Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,584" Grid.RowSpan="2" Loaded="Header_Loaded"/>

        <!-- MainContent -->
        <layouts:MainContent Grid.Row="1" Grid.ColumnSpan="2" Loaded="MainContent_Loaded"/>
    </Grid>
</Window>
