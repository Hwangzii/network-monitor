<UserControl x:Class="MonitorApp.Views.Layouts.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Width="auto"
             Background="White"
             Height="68">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Logo -->
            <ColumnDefinition Width="*"/>
            <!-- Tabs -->
            <ColumnDefinition Width="Auto"/>
            <!-- Avatar + Upgrade -->
        </Grid.ColumnDefinitions>

        <!-- LEFT: GlassWire FREE -->
        <StackPanel Grid.Column="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    Margin="18,0,32,0">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Nhóm 5"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           VerticalAlignment="Center"/>

                <!-- dropdown mũi tên nhỏ -->
                <iconPacks:PackIconFeatherIcons Kind="ChevronDown" Width="15" Height="15" Foreground="#666666"
                      Margin="4,4,0,0"/>
            </StackPanel>

            <TextBlock Text="22CN1"
                       FontSize="11"
                       Foreground="#B0B0B0"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- CENTER: Tabs -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Traffic Monitor (đang chọn) -->
            <RadioButton Style="{StaticResource NavButtonStyle}"
                         Content="Traffic&#x0a;Monitor"
                         GroupName="MainTabs"
                         IsChecked="True" Checked="RadioButton_Checked">
                <RadioButton.Tag>
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <!-- icon "núi" đơn giản -->
                            <iconPacks:PackIconFeatherIcons Kind="BarChart" Width="20" Height="20" Foreground="#666666"/>

                        </Canvas>
                    </Viewbox>
                </RadioButton.Tag>
            </RadioButton>

            <!-- GlassWire Protect -->
            <RadioButton Style="{StaticResource NavButtonStyle}"
                         Content="GlassWire&#x0a;Protect"
                         GroupName="MainTabs">
                <RadioButton.Tag>
                    <Viewbox Width="24" Height="24">
                        <iconPacks:PackIconFeatherIcons Kind="Shield" Width="20" Height="20" Foreground="#666666"/>

                    </Viewbox>
                </RadioButton.Tag>
            </RadioButton>

            <!-- Log Analysis + badge 9+ -->
            <RadioButton Style="{StaticResource NavButtonStyle}"
                         Content="Log&#x0a;Analysis"
                         GroupName="MainTabs">
                <RadioButton.Tag>
                    <Grid>
                        <Viewbox Width="24" Height="24">
                            <iconPacks:PackIconFeatherIcons Kind="MapPin" Width="20" Height="20" Foreground="#666666"/>

                        </Viewbox>

                        <Border Style="{StaticResource BadgeStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <TextBlock Text="9+"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </RadioButton.Tag>
            </RadioButton>

            <!-- Network Scanner -->
            <RadioButton Style="{StaticResource NavButtonStyle}"
                         Content="Network&#x0a;Scanner"
                         GroupName="MainTabs">
                <RadioButton.Tag>
                    <Viewbox Width="24" Height="24">
                        <iconPacks:PackIconFeatherIcons Kind="GitBranch" Width="20" Height="20" Foreground="#666666"/>

                    </Viewbox>
                </RadioButton.Tag>
            </RadioButton>
        </StackPanel>

        <!-- RIGHT: Avatar + Get All Premium Features + UPGRADE -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,18,0">

            <!-- Text 2 dòng -->
            <TextBlock Text="Get All Premium&#x0a;Features"
                       FontSize="11"
                       Foreground="#9E9E9E"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

        </StackPanel>
    </Grid>
</UserControl>
