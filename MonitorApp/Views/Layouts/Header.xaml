<UserControl x:Class="MonitorApp.Views.Layouts.Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             Height="80">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Logo -->
            <ColumnDefinition Width="*"/>
            <!-- Tabs -->
            <ColumnDefinition Width="Auto"/>
            <!-- Avatar + Upgrade -->
        </Grid.ColumnDefinitions>

        <!-- LEFT: GlassWire FREE -->
        <StackPanel Grid.Column="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    Margin="18,0,32,0">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GlassWire"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           VerticalAlignment="Center"/>

                <!-- dropdown mũi tên nhỏ -->
                <Path Data="M4 7l4 4 4-4"
                      Stroke="#777777"
                      StrokeThickness="1.5"
                      Stretch="Uniform"
                      Width="10" Height="10"
                      Margin="4,2,0,0"/>
            </StackPanel>

            <TextBlock Text="FREE"
                       FontSize="11"
                       Foreground="#B0B0B0"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- CENTER: Tabs -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Traffic Monitor (đang chọn) -->
            <RadioButton Style="{StaticResource NavButtonStyle}"
                         Content="Traffic&#x0a;Monitor"
                         GroupName="MainTabs"
                         IsChecked="True">
                <RadioButton.Tag>
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <!-- icon "núi" đơn giản -->
                            <Path Fill="#666666"
                                  Data="M3,18L8,8L13,18L17,11L21,18Z"/>
                        </Canvas>
                    </Viewbox>
                </RadioButton.Tag>
            </RadioButton>

            <!-- GlassWire Protect -->
            <RadioButton Style="{StaticResource NavButtonStyle}"
                         Content="GlassWire&#x0a;Protect"
                         GroupName="MainTabs">
                <RadioButton.Tag>
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#757575"
                                  Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,16.5L8.5,13L9.91,11.59L12,13.67L15.59,10.09L17,11.5L12,16.5Z"/>
                        </Canvas>
                    </Viewbox>
                </RadioButton.Tag>
            </RadioButton>

            <!-- Log Analysis + badge 9+ -->
            <RadioButton Style="{StaticResource NavButtonStyle}"
                         Content="Log&#x0a;Analysis"
                         GroupName="MainTabs">
                <RadioButton.Tag>
                    <Grid>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#757575"
                                      Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M11,6H13V13H11V6M11,15H13V17H11V15Z"/>
                            </Canvas>
                        </Viewbox>

                        <Border Style="{StaticResource BadgeStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <TextBlock Text="9+"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </RadioButton.Tag>
            </RadioButton>

            <!-- Network Scanner -->
            <RadioButton Style="{StaticResource NavButtonStyle}"
                         Content="Network&#x0a;Scanner"
                         GroupName="MainTabs">
                <RadioButton.Tag>
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#757575"
                                  Data="M5,11A2,2 0 1,0 5,7A2,2 0 0,0 5,11M12,13A2,2 0 1,0 12,9A2,2 0 0,0 12,13M19,17A2,2 0 1,0 19,13A2,2 0 0,0 19,17M6.5,9.5L10.5,11.5M13.5,12.5L17.5,15.5"/>
                        </Canvas>
                    </Viewbox>
                </RadioButton.Tag>
            </RadioButton>
        </StackPanel>

        <!-- RIGHT: Avatar + Get All Premium Features + UPGRADE -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,18,0">

            <!-- Text 2 dòng -->
            <TextBlock Text="Get All Premium&#x0a;Features"
                       FontSize="11"
                       Foreground="#9E9E9E"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

        </StackPanel>
    </Grid>
</UserControl>
