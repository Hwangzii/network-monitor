<UserControl x:Class="MonitorApp.Views.Pages.SpeedTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1100"
             Background="#F5F7FB">

    <UserControl.DataContext>
        <vm:SpeedTestViewModel />
    </UserControl.DataContext>

        <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header (filters, search, button) -->
            <RowDefinition Height="Auto"/>
            <!-- Content (log list) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Filters -->
                <ColumnDefinition Width="*"/>
                <!-- Spacer -->
                <ColumnDefinition Width="Auto"/>
                <!-- Search -->
                <ColumnDefinition Width="Auto"/>
                <!-- Mark all as read -->
            </Grid.ColumnDefinitions>

            <!-- Filters: Important / All Time -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                       >
                <ComboBox Width="130"
                          Height="32"
                          SelectedIndex="0"
                          Padding="8,2"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Important"/>
                    <ComboBoxItem Content="All Alerts"/>
                    <ComboBoxItem Content="Blocked Only"/>
                </ComboBox>

                <ComboBox Width="130"
                          Height="32"
                          SelectedIndex="0"
                          Padding="8,2"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="All Time"/>
                    <ComboBoxItem Content="Today"/>
                    <ComboBoxItem Content="Last 7 days"/>
                    <ComboBoxItem Content="Last 30 days"/>
                </ComboBox>
            </StackPanel>

            <!-- Search box -->
            <Border Grid.Column="2"
                    Margin="16,0"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="#D2D7E4"
                    Background="White"
                    Height="32">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Fake search icon -->
                    <Ellipse Width="16" Height="16"
                             StrokeThickness="2"
                             Stroke="#A0A6B8"
                             VerticalAlignment="Center"/>
                    <Rectangle Width="6" Height="2"
                               StrokeThickness="2"
                               Stroke="#A0A6B8"
                               RenderTransformOrigin="0.5,0.5"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,-2,-2">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <TextBox Grid.Column="1"
                             Margin="8,0,0,0"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             Foreground="#444"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             />
                </Grid>
            </Border>

            <!-- Mark all as read button -->
            <Button Grid.Column="3"
                    Content="Mark all as read"
                    Height="32"
                    Padding="16,0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding MarkAllAsReadCommand}">
            </Button>
        </Grid>

        <!-- ================= CONTENT ================= -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" >

                <!-- ====== Today group ====== -->
                <TextBlock Text="Today"
                           FontWeight="SemiBold"
                           Foreground="#555"
                           Margin="0,0,0,4"/>

                <!-- 1 alert item giống top card trong ảnh -->
                <Border CornerRadius="8"
                        Background="#FFFDF8E7"
                        BorderBrush="#FFE5C48C"
                        BorderThickness="1"
                        Padding="16"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Status dot -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Icon & NEW -->
                            <ColumnDefinition Width="*"/>
                            <!-- Main content -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Right info -->
                        </Grid.ColumnDefinitions>

                        <!-- Status dot -->
                        <Ellipse Grid.Column="0"
                                 Width="8" Height="8"
                                 Fill="#F35656"
                                 VerticalAlignment="Top"
                                 Margin="0,4,8,0"/>

                        <!-- App icon + NEW pill -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Vertical"
                                    Margin="0,0,16,0">
                            <Border Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="#E8F0FF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top">
                                <TextBlock Text="e"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="#3361FF"/>
                            </Border>

                            <Border CornerRadius="10"
                                    Background="#28A745"
                                    Padding="8,2"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="NEW"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Main text -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical"
                                    >
                            <TextBlock Text="Microsoft Edge WebView2 initiated its first network connection to"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" >
                                <!-- small document icon -->
                                <Rectangle Width="14" Height="14"
                                           RadiusX="2" RadiusY="2"
                                           Stroke="#B0B6C6"
                                           StrokeThickness="1"
                                           Fill="Transparent"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="fe80::b286:f656:1f68:fe43"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#666"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right info: label + time -->
                        <StackPanel Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Margin="16,0,0,0"
                                    >
                            <TextBlock Text="First network activity"
                                       FontSize="11"
                                       Foreground="#777"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="7:14 am"
                                       FontSize="11"
                                       Foreground="#999"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ====== Yesterday group (placeholder) ====== -->
                <TextBlock Text="Yesterday"
                           FontWeight="SemiBold"
                           Foreground="#555"
                           Margin="0,16,0,4"/>

                <!-- Placeholder card list, anh có thể đổi sang ItemsControl/ListView binding Alerts -->
                <Border CornerRadius="8"
                        Background="White"
                        BorderBrush="#E1E5F0"
                        BorderThickness="1"
                        Padding="16">
                    <TextBlock Text="Upgrade to see unlimited alert history..."
                               Foreground="#777"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
