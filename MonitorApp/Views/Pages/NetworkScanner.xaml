<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="MonitorApp.Views.Pages.NetworkScanner"
             Background="#F5F7FB" d:DesignHeight="470.075" d:DesignWidth="1128.316">

    <!-- Styles dùng cho NavButtonStyle, BadgeStyle... -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <!-- Header -->
            <RowDefinition Height="3"/>
            <!-- line xanh -->
            <RowDefinition Height="Auto"/>
            <!-- thanh trên (adapter + search) -->
            <RowDefinition Height="*"/>
            <!-- bảng devices -->
            <RowDefinition Height="8"/>
            <!-- footer xanh lá -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Nhóm / Lớp -->
                <ColumnDefinition Width="*"/>
                <!-- Tabs -->
                <ColumnDefinition Width="Auto"/>
                <!-- English -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Nhóm + Lớp -->
            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="18,0,32,0">
                <TextBlock Text="Nhóm 5"
                           FontWeight="Bold"
                           FontSize="16"/>
                <TextBlock Text="Lớp 22CNT"
                           FontSize="12"
                           Foreground="#777777"/>
            </StackPanel>

            <!-- CENTER: TABS -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Traffic Monitor -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="Traffic&#xA;Monitor"
                             GroupName="MainTabs">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#666666"
                                      Data="M3,18L8,8L13,18L17,11L21,18Z"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>

                <!-- GlassWire Protect -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="GlassWire&#xA;Protect"
                             GroupName="MainTabs">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#757575"
                                      Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,16.5L8.5,13L9.91,11.59L12,13.67L15.59,10.09L17,11.5L12,16.5Z"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>

                <!-- Log Analysis -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="Log&#xA;Analysis"
                             GroupName="MainTabs">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="20" Height="20" Fill="#CCCCCC"/>
                                <Ellipse Width="10" Height="10" Fill="White"
                                         Canvas.Left="5" Canvas.Top="5"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>

                <!-- Network Scanner (ACTIVE) -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="Network&#xA;Scanner"
                             GroupName="MainTabs"
                             IsChecked="True">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#4C6FFF"
                                      Data="M4,12A8,8 0 1,1 12,20A8,8 0 0,1 4,12Z"/>
                                <Path Fill="White"
                                      Data="M8,12A4,4 0 1,1 12,16A4,4 0 0,1 8,12Z"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>
            </StackPanel>

            <!-- RIGHT: English -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0">
                <TextBlock Text="English"
                           FontSize="12"
                           Margin="0,0,6,0"/>
                <Border Width="24" Height="16"
                        Background="#DDDDDD"
                        CornerRadius="2"/>
            </StackPanel>
        </Grid>

        <!-- line xanh dưới header -->
        <Border Grid.Row="1" Background="#2F80ED"/>

        <!-- ================= TOP BAR (Adapter + Scan + Search) ================= -->
        <Grid Grid.Row="2" Background="White" Height="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- adapter + Scan -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Search + Auto-scan -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Adapter + Scan + Scanned time -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">

                <!-- Adapter dropdown -->
                <Border CornerRadius="16"
                        Background="#F5F7FA"
                        BorderBrush="#D1D7E0"
                        BorderThickness="1"
                        Padding="14,6"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Realtek PCIe GbE Family Controller"
                                   FontSize="12"
                                   Margin="0,0,6,0"/>
                        <Path Data="M4 7l4 4 4-4"
                              Stroke="#555"
                              StrokeThickness="1.5"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scan button -->
                <Border CornerRadius="16"
                        Background="#2F80ED"
                        Padding="22,6"
                        Margin="0,0,10,0">
                    <TextBlock Text="Scan"
                               FontSize="12"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Scanned time -->
                <TextBlock Text="Scanned: 11 Nov"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="#777777"/>
            </StackPanel>

            <!-- RIGHT: Search + Auto-scan + icons -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0">

                <!-- Search box -->
                <Border CornerRadius="18"
                        Background="#F1F3F4"
                        BorderBrush="#DADCE0"
                        BorderThickness="1"
                        Height="34"
                        Width="230"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="16" Height="16"
                                Margin="12,0,6,0"
                                VerticalAlignment="Center"
                                Background="#CCCCCC"
                                CornerRadius="8"/>
                        <TextBox Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 Foreground="#555"
                                 Margin="0,0,10,0"/>
                    </Grid>
                </Border>

                <!-- Auto-scan label + toggle -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="Auto-scan"
                               FontSize="12"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <!-- toggle đơn giản -->
                    <Grid Width="34" Height="18">
                        <Border CornerRadius="9"
                                Background="#D1D7E0"/>
                        <Ellipse Width="14" Height="14"
                                 Fill="White"
                                 Margin="2,2,0,2"
                                 HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>

                <!-- 2 icon nhỏ (giống hình: clock + settings) -->
                <Border Width="28" Height="28"
                        CornerRadius="14"
                        Background="#F5F7FA"
                        BorderBrush="#D1D7E0"
                        BorderThickness="1"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center">
                    <!-- clock -->
                    <Canvas Width="16" Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Ellipse Width="16" Height="16"
                                 Stroke="#555" StrokeThickness="1"/>
                        <Line X1="8" Y1="3" X2="8" Y2="8"
                             Stroke="#555" StrokeThickness="1"/>
                        <Line X1="8" Y1="8" X2="11" Y2="10"
                             Stroke="#555" StrokeThickness="1"/>
                    </Canvas>
                </Border>

                <Border Width="28" Height="28"
                        CornerRadius="14"
                        Background="#F5F7FA"
                        BorderBrush="#D1D7E0"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <!-- gear đơn giản -->
                    <Canvas Width="16" Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 Stroke="#555" StrokeThickness="1"
                                 Canvas.Left="3" Canvas.Top="3"/>
                    </Canvas>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ================= TABLE DEVICES ================= -->
        <Grid Grid.Row="3" Background="#F9FAFB">
            <Border Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,10,16,0">

                        <!-- HEADER CỘT -->
                        <Grid Background="#F5F7FA" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <!-- # -->
                                <ColumnDefinition Width="60"/>
                                <!-- Type -->
                                <ColumnDefinition Width="140"/>
                                <!-- Name -->
                                <ColumnDefinition Width="180"/>
                                <!-- Description -->
                                <ColumnDefinition Width="100"/>
                                <!-- Location -->
                                <ColumnDefinition Width="80"/>
                                <!-- System -->
                                <ColumnDefinition Width="110"/>
                                <!-- IP -->
                                <ColumnDefinition Width="150"/>
                                <!-- MAC -->
                                <ColumnDefinition Width="130"/>
                                <!-- Last Seen -->
                                <ColumnDefinition Width="130"/>
                                <!-- First Seen -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="#" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Type" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Name" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="Description" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="Location" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="System" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="IP" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="MAC Address" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="Last Seen" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="First Seen" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ===== 1 ROW MẪU – copy thêm để có list dài ===== -->
                        <Grid Height="34" Background="#FBFBFB">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <!-- # + radio nhỏ -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10"
                                         Stroke="#BBBBBB"
                                         StrokeThickness="1"
                                         Fill="White"/>
                            </StackPanel>

                            <!-- Type -->
                            <TextBlock Grid.Column="1"
                                       Text="Wi-Fi"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>

                            <!-- Name -->
                            <TextBlock Grid.Column="2"
                                       Text="Senao Networks, ECW120"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontSize="12"/>

                            <!-- Description -->
                            <TextBlock Grid.Column="3"
                                       Text="Senao Networks, ECW120"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontSize="12"/>

                            <!-- Location -->
                            <TextBlock Grid.Column="4"
                                       Text=""
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>

                            <!-- System -->
                            <TextBlock Grid.Column="5"
                                       Text=""
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>

                            <!-- IP -->
                            <TextBlock Grid.Column="6"
                                       Text="192.168.114.46"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>

                            <!-- MAC -->
                            <TextBlock Grid.Column="7"
                                       Text="88:DC:97:13:54:A3"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>

                            <!-- Last Seen -->
                            <TextBlock Grid.Column="8"
                                       Text="11 Nov, 2025, 9:19 AM"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>

                            <!-- First Seen -->
                            <TextBlock Grid.Column="9"
                                       Text="11 Nov, 2025, 9:19 AM"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                        </Grid>

                        <!-- copy Grid bên trên nhiều lần để có danh sách dài giống hình -->

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER XANH LÁ -->
        <Border Grid.Row="4" Background="#E0FFB3"/>
    </Grid>
</UserControl>
