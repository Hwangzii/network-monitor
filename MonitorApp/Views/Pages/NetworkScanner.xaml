<UserControl x:Class="MonitorApp.Views.Pages.NetworkScanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1100"
             Background="#F5F7FB">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Styles chung của app -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Table -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: device dropdown + menu + last seen -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        >

                <!-- Device dropdown -->
                <Border Style="{StaticResource DropdownBorder}">
                    <DockPanel>
                        <!-- fake wifi icon -->
                        <Ellipse Width="14" Height="14"
                                 Stroke="#2E8AE6"
                                 StrokeThickness="2"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SelectedDeviceName, FallbackValue=DESKTOP của đạt}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#333"/>
                        <TextBlock Text="▼"
                                   DockPanel.Dock="Right"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#999"
                                   FontSize="10"/>
                    </DockPanel>
                </Border>

                <!-- More menu -->
                <Button Width="28" Height="28"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent">
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                >
                        <Ellipse Width="3" Height="3" Fill="#555"/>
                        <Ellipse Width="3" Height="3" Fill="#555"/>
                        <Ellipse Width="3" Height="3" Fill="#555"/>
                    </StackPanel>
                </Button>

                <!-- Last seen text -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                           >
                    <TextBlock Text="Last seen"
                               Foreground="#777"/>
                    <TextBlock Text="{Binding LastSeenSummary, FallbackValue='11 Nov, 2025'}"
                               Foreground="#333"
                               FontWeight="SemiBold"/>

                </StackPanel>
            </StackPanel>

            <!-- Search box -->
            <Border Grid.Column="2"
                    Style="{StaticResource SearchBoxBorder}"
                    Margin="0,0,16,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- search icon -->
                    <Ellipse Width="14" Height="14"
                             Stroke="#A0A6B8"
                             StrokeThickness="2"
                             VerticalAlignment="Center"/>
                    <Rectangle Width="6" Height="2"
                               Stroke="#A0A6B8"
                               StrokeThickness="2"
                               RenderTransformOrigin="0.5,0.5"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,-2,-2">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <TextBox Grid.Column="1"
                             Margin="8,0,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             Foreground="#444"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             />
                </Grid>
            </Border>

            <!-- Auto-scan + settings -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        >

                <StackPanel Orientation="Horizontal" >
                    <TextBlock Text="Auto-scan"
                               Foreground="#555"
                               VerticalAlignment="Center"/>
                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding IsAutoScanEnabled}"/>
                </StackPanel>

                <!-- Settings button -->
                <Button Width="32" Height="32"
                        BorderThickness="0"
                        Background="Transparent">
                    <Grid Width="18" Height="18">
                        <Ellipse Stroke="#555" StrokeThickness="2"/>
                        <Rectangle Width="4" Height="4"
                                   Fill="#555"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= TABLE ================= -->
        <Border Grid.Row="1"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{StaticResource ColorBorderTable}"
                Background="White">
            <DataGrid ItemsSource="{Binding Devices}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      RowHeaderWidth="0"
                      AlternationCount="2"
                      ColumnHeaderStyle="{StaticResource TableColumnHeaderStyle}"
                      RowStyle="{StaticResource TableRowStyle}"
                      HorizontalGridLinesBrush="#F0F2F7"
                      VerticalGridLinesBrush="#F0F2F7"
                      FontSize="12"
                      Padding="0"
                      BorderThickness="0">

                <!-- Type -->
                <DataGridTemplateColumn Header="Type" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        >
                                <Ellipse Width="8" Height="8"
                                         Fill="#4CAF50"
                                         VerticalAlignment="Center"/>
                                <Ellipse Width="20" Height="20"
                                         Stroke="#B0B6C6"
                                         StrokeThickness="1"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="150"/>
                <DataGridTextColumn Header="IP"
                                    Binding="{Binding IpAddress}"
                                    Width="140"/>
                <DataGridTextColumn Header="Location"
                                    Binding="{Binding Location}"
                                    Width="120"/>
                <DataGridTextColumn Header="Description"
                                    Binding="{Binding Description}"
                                    Width="140"/>
                <DataGridTextColumn Header="System"
                                    Binding="{Binding System}"
                                    Width="120"/>
                <DataGridTextColumn Header="MAC Address"
                                    Binding="{Binding MacAddress}"
                                    Width="160"/>
                <DataGridTextColumn Header="Last Seen"
                                    Binding="{Binding LastSeen}"
                                    Width="160"/>
                <DataGridTextColumn Header="First Seen"
                                    Binding="{Binding FirstSeen}"
                                    Width="160"/>

            </DataGrid>
        </Border>
    </Grid>

</UserControl>
