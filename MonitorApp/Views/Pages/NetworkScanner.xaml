<UserControl x:Class="MonitorApp.Views.Pages.NetworkScanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:MonitorApp.Converters"
              xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels"
             mc:Ignorable="d"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"

             d:DesignHeight="600"
             d:DesignWidth="1100"
             Loaded="UserControl_Loaded"
             Background="White">
    
    <UserControl.DataContext>
        <vm:NetworkScannerViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:Base64SvgToTempFileConverter x:Key="Base64SvgToTempFile"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--  HEADER  -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        >

                <Border Style="{StaticResource DropdownBorder}">
                    <DockPanel>
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="Green" StrokeThickness="2" Data="M12 18 L12.01 18"/>
                                <Path Stroke="Green" StrokeThickness="2" Data="M9.172 15.172a4 4 0 0 1 5.656 0"/>
                                <Path Stroke="Green" StrokeThickness="2" Data="M6.343 12.343a8 8 0 0 1 11.314 0"/>
                                <Path Stroke="Green" StrokeThickness="2" Data="M3.515 9.515c4.686 -4.687 12.284 -4.687 17 0"/>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="{Binding SelectedDeviceName}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#333"/>
                    </DockPanel>
                </Border>

                <Button Grid.Column="0"
                        Style="{StaticResource ScanButtonStyle}"
                        Content="Scan"
                        Margin="8,0,0,0"
                        Width="54"
                        Padding="16"
                        Command="{Binding ScanCommand}" />


                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                           >
                    <TextBlock Text="Last seen"
                               Foreground="#777"/>
                    <TextBlock Text="{Binding LastSeenSummary, FallbackValue='11 Nov, 2025'}"
                               Foreground="#333"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"/>

                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2"
                    Margin="0,0,16,0"
                    Height="32"
                    Width="260"            
                    CornerRadius="16"
                    Background="#F5F7FB"
                    BorderBrush="#E0E4EC"
                    BorderThickness="1">

                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="16" Height="16"
                             VerticalAlignment="Center">
                        <Grid Width="24" Height="24">
                            <Ellipse Width="14"
                                     Height="14"
                                     Stroke="#A0A6B8"
                                     StrokeThickness="1.8"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                            <Line X1="13" Y1="13"
                                  X2="19" Y2="19"
                                  Stroke="#A0A6B8"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Margin="-1,4,1,-4"/>
                        </Grid>
                    </Viewbox>
                    <TextBox Grid.Column="1"
                             Margin="8,0,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Foreground="#666"
                             Padding="0"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 />
                </Grid>
            </Border>

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        >

                <StackPanel Orientation="Horizontal" >
                    <TextBlock Text="Auto-scan"
                               Foreground="#555"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding IsAutoScanEnabled}"/>
                </StackPanel>
            </StackPanel>
            
        </Grid>

        <!-- ================= TABLE ================= -->
        <Border Grid.Row="1"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{StaticResource ColorBorderTable}"
                Background="Transparent">
            <DataGrid ItemsSource="{Binding FilteredDevices}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      RowHeaderWidth="0"
                      AlternationCount="2"
                      ColumnHeaderStyle="{StaticResource TableColumnHeaderStyle}"
                      RowStyle="{StaticResource TableRowStyle}"
                      HorizontalGridLinesBrush="#F0F2F7"
                      VerticalGridLinesBrush="#F0F2F7"
                      FontSize="12"
                      Padding="0"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">

                <!--  nằm trong DataGrid.Columns *** -->
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Type" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                                    <!-- Dot trạng thái online/offline -->
                                    <Ellipse Width="8"
                                             Height="8"
                                             VerticalAlignment="Center"
                                             Margin="6,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <Border Width="20" Height="20"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            VerticalAlignment="Center">
                                        <svgc:SvgViewbox Margin="0"
                                             Stretch="Uniform"
                                             Source="{Binding IconDeviceUrl, Converter={StaticResource Base64SvgToTempFile}}"/>
                                    </Border>


                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Các cột text  -->
                    <DataGridTextColumn Header="Name"
                            Binding="{Binding Name}"
                            Width="150"
                            ElementStyle="{StaticResource CenterCellTextStyle}"
                            EditingElementStyle="{StaticResource CenterCellTextStyle}"/>

                    <DataGridTextColumn Header="IP"
                            Binding="{Binding IpAddress}"
                            Width="140"
                            ElementStyle="{StaticResource CenterCellTextStyle}"
                            EditingElementStyle="{StaticResource CenterCellTextStyle}"/>

                    <DataGridTextColumn Header="Location"
                            Binding="{Binding Location}"
                            Width="120"
                            ElementStyle="{StaticResource CenterCellTextStyle}"
                            EditingElementStyle="{StaticResource CenterCellTextStyle}"                                        />

                    <DataGridTextColumn Header="Description"
                            Binding="{Binding Description}"
                            Width="140"
                            ElementStyle="{StaticResource CenterCellTextStyle}"
                            EditingElementStyle="{StaticResource CenterCellTextStyle}"                                        />

                    <DataGridTextColumn Header="System"
                            Binding="{Binding System}"
                            Width="120"
                            ElementStyle="{StaticResource CenterCellTextStyle}"
                            EditingElementStyle="{StaticResource CenterCellTextStyle}"                                        />

                    <DataGridTextColumn Header="Ports"
                            Binding="{Binding Ports}"
                            Width="120"
                            ElementStyle="{StaticResource CenterCellTextStyle}"
                            EditingElementStyle="{StaticResource CenterCellTextStyle}" />


                    <DataGridTextColumn Header="MAC Address"
                            Binding="{Binding MacAddress}"
                            Width="160"
                            ElementStyle="{StaticResource CenterCellTextStyle}"
                            EditingElementStyle="{StaticResource CenterCellTextStyle}"                                        />

                    <DataGridTextColumn Header="Last Seen"
                            Binding="{Binding LastSeen}"
                            Width="160"
                            ElementStyle="{StaticResource CenterCellTextStyle}"
                            EditingElementStyle="{StaticResource CenterCellTextStyle}"                                        />

                    <DataGridTextColumn Header="First Seen"
                            Binding="{Binding FirstSeen}"
                            Width="160"
                            ElementStyle="{StaticResource CenterCellTextStyle}"
                            EditingElementStyle="{StaticResource CenterCellTextStyle}"                                        />

                </DataGrid.Columns>
            </DataGrid>

        </Border>
    </Grid>

</UserControl>
