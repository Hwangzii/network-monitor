<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.FooterParts.TM_Footer_CenterDonut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Grid Width="160" Height="90">

        <!-- DOWNLOAD (vàng) – cố định 70% – từ chân trái, đi lên đúng 126° (70% của 180°) -->
        <Path Stroke="#FBBF24" 
              StrokeThickness="12"
              StrokeStartLineCap="Square"
              StrokeEndLineCap="Square">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="20,100">
                        <ArcSegment Point="116.57,41.43" 
                                    Size="60,60" 
                                    SweepDirection="Clockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- UPLOAD (hồng) – cố định 30% – từ chân phải, đi lên đúng 54° (30% của 180°) -->
        <Path Stroke="#F9A8D4" 
              StrokeThickness="12"
              StrokeStartLineCap="Square"
              StrokeEndLineCap="Square">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="140,100">
                        <ArcSegment Point="116.57,41.43" 
                                    Size="60,60" 
                                    SweepDirection="Counterclockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- Icon Bell + Total Usage – căn giữa, sát đáy -->
        <StackPanel VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
            <iconPacks:PackIconFeatherIcons Kind="Bell"
                                            Width="16" Height="16"
                                            Foreground="#94A3B8"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,6"/>
            <TextBlock Text="{Binding TotalUsage}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#2B3440"
                       HorizontalAlignment="Center"/>
        </StackPanel>

    </Grid>
</UserControl>