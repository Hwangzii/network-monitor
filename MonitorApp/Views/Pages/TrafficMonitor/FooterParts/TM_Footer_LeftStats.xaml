             xmlns:local="clr-namespace:MonitorApp.Views.Pages.TrafficMonitor.FooterParts">

    <Grid Width="440" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="160"/>
