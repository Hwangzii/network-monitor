<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Footer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels.TrafficMonitor"
             xmlns:conv="clr-namespace:MonitorApp.Converters"
             mc:Ignorable="d"
             Height="186.3">

    <!-- ViewModel -->
    <UserControl.DataContext>
        <vm:TM_FooterViewModel />
    </UserControl.DataContext>

    <!-- Resources -->
    <UserControl.Resources>
        <ResourceDictionary>

            <!-- Converters -->
            <conv:PercentToArcEndPointConverter x:Key="PercentToArcEndPointConverter" />
            <conv:PercentToStarGridLengthConverter x:Key="PercentToStarGridLengthConverter" />

            <!-- Brushes -->
            <SolidColorBrush x:Key="ColorDown" Color="#FBBF24" />
            <SolidColorBrush x:Key="ColorUp"   Color="#F9A8D4" />
            <SolidColorBrush x:Key="ColorBg"   Color="Transparent" />
            <SolidColorBrush x:Key="TextMuted" Color="#7C8591" />

            <!-- Styles riêng -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>

        <!-- ==================== TOP ==================== -->
        <Border Grid.Row="0" Style="{StaticResource FooterBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Left: số liệu + semi-donut ===== -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Download (trái) -->
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="0,0,16,0">
                        <TextBlock Text="{Binding DownloadTotalText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2B3440"
                                   Margin="0,0,20,0" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,2,20,0">
                            <TextBlock Text="{Binding DownloadSpeedText}"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,0,20,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Semi donut -->
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>

                        <!-- icon mũi tên -->
                        <iconPacks:PackIconFeatherIcons Kind="ArrowDown"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="{StaticResource ColorDown}"
                                                        Margin="0,50,0,0" />
                        <iconPacks:PackIconFeatherIcons Kind="ArrowUp"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="{StaticResource ColorUp}"
                                                        Margin="190,50,0,0" />

                        <!-- 1. NỀN XÁM: nửa vòng -->
                        <Path Stroke="{StaticResource ColorBg}"
                              StrokeThickness="12"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="30,90" IsFilled="False">
                                        <ArcSegment Point="180,90"
                                                    Size="75,75"
                                                    SweepDirection="Clockwise" />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>

                        <!-- 2. UPLOAD: full nửa vòng HỒNG -->
                        <Path Stroke="{StaticResource ColorUp}"
                              StrokeThickness="12"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="30,90" IsFilled="False">
                                        <ArcSegment Point="180,90"
                                                    Size="75,75"
                                                    SweepDirection="Clockwise" />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>

                        <!-- 3. DOWNLOAD: cung VÀNG theo % Download -->
                        <Path Stroke="{StaticResource ColorDown}"
                              StrokeThickness="12"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="30,90" IsFilled="False">
                                        <ArcSegment Size="75,75"
                                                    SweepDirection="Clockwise"
                                                    Point="{Binding ArcDownloadPercent,
                                                            Converter={StaticResource PercentToArcEndPointConverter},
                                                            ConverterParameter='105,90,75'}" />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>

                        <!-- icon chuông ở giữa vòng -->
                        <Grid VerticalAlignment="Top"
                              HorizontalAlignment="Center"
                              Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconFeatherIcons Kind="Bell"
                                                                Width="15"
                                                                Height="15"
                                                                Foreground="#9AA3AE"
                                                                Margin="0,20,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Tổng đã dùng -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding TotalUsedText}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#2B3440"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,70,0,0" />
                    </Grid>

                    <!-- Upload (phải) -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="16,0,0,0">
                        <TextBlock Text="{Binding UploadTotalText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2B3440"
                                   Margin="20,0,0,0" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="20,2,0,0">
                            <TextBlock Text="{Binding UploadSpeedText}"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,0,8,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Divider -->
                <Rectangle Grid.Column="1"
                           Width="1"
                           Fill="#E7EBF0"
                           Margin="12,10,12,8" />

                <!-- ===== Right: WAN / LAN ===== -->
                <Grid Grid.Column="2" Margin="12,6,40,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <!-- WAN row -->
                    <TextBlock Grid.Row="0"
                               Text="WAN"
                               Foreground="{StaticResource TextMuted}"
                               FontWeight="SemiBold" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- WAN size -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding WanSizeText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#2B3440"
                                   VerticalAlignment="Center" />

                        <!-- WAN bar -->
                        <Border Grid.Column="1"
                                Height="8"
                                Background="{StaticResource ColorBg}"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <Grid Width="{Binding WanFillWidth}"
                                  HorizontalAlignment="Left"
                                  Height="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding WanDownPercent,
                                               Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                    <ColumnDefinition Width="{Binding WanUpPercent,
                                               Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource ColorDown}"
                                        CornerRadius="4,0,0,4" />
                                <Border Grid.Column="1"
                                        Background="{StaticResource ColorUp}"
                                        CornerRadius="0,4,4,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- LAN row -->
                    <TextBlock Grid.Row="2"
                               Text="LAN"
                               Foreground="{StaticResource TextMuted}"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding LanSizeText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#2B3440"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1"
                                Height="8"
                                Background="{StaticResource ColorBg}"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <Grid Width="{Binding LanFillWidth}"
                                  HorizontalAlignment="Left"
                                  Height="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding LanDownPercent,
                                               Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                    <ColumnDefinition Width="{Binding LanUpPercent,
                                               Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource ColorDown}"
                                        CornerRadius="4,0,0,4" />
                                <Border Grid.Column="1"
                                        Background="{StaticResource ColorUp}"
                                        CornerRadius="0,4,4,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== TIMELINE ==================== -->
        <Border Grid.Row="1" Style="{StaticResource TimelineBorderStyle}">
            <Grid ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding TimeLabels}"
                              Style="{StaticResource TimeLabelsStyle}">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform X="{Binding SmoothScrollOffset}" />
                    </ItemsControl.RenderTransform>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
