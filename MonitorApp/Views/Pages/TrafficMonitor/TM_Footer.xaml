<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Footer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels.TrafficMonitor"
             xmlns:conv="clr-namespace:MonitorApp.Converters"
             mc:Ignorable="d"
             >


    <!-- ViewModel -->
    <UserControl.DataContext>
        <vm:TM_FooterViewModel />
    </UserControl.DataContext>

    <!-- Resources -->
    <UserControl.Resources>
        <ResourceDictionary>

            <!-- Converters -->
            <conv:PercentToArcEndPointConverter x:Key="PercentToArcEndPointConverter" />
            <conv:PercentToStarGridLengthConverter x:Key="PercentToStarGridLengthConverter" />

            <!-- Brushes -->
            <SolidColorBrush x:Key="ColorDown" Color="#FBBF24" />
            <SolidColorBrush x:Key="ColorUp"   Color="#F9A8D4" />
            <SolidColorBrush x:Key="ColorBg"   Color="Transparent" />
            <SolidColorBrush x:Key="TextMuted" Color="#7C8591" />

            <!-- Styles riêng -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!-- ==================== TOP ==================== -->
        <Border Grid.Row="0" Style="{StaticResource FooterBorderStyle}">
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Left: số liệu + semi-donut ===== -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Download  -->
                    <Grid Grid.Column="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0"
                              Margin="0,0,20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{Binding DownloadTotalText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#2B3440"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"/>  

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,2,0,0">

                                <TextBlock Text="{Binding DownloadSpeedText}"
                                           Foreground="{StaticResource TextMuted}"
                                           TextAlignment="Right"/>
                            </StackPanel>


                        </Grid>

                        <Grid Grid.Column="1">
                            <iconPacks:PackIconFeatherIcons Kind="ArrowDown"
                                                        Width="24"
                                                        Height="24"
                                                        Foreground="{StaticResource ColorDown}"
                                                        Margin="0,0,0,0"
                                                            VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Semi donut -->
                    <Grid Grid.Column="1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100" />
                        </Grid.RowDefinitions>

                        <!-- 1. NỀN XÁM -->
                        <Path Stroke="{StaticResource ColorBg}"
                              StrokeThickness="12"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="30,90" IsFilled="False">
                                        <ArcSegment Point="180,90"
                                                    Size="75,75"
                                                    SweepDirection="Clockwise" />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>

                        <!-- 2. UPLOAD -->
                        <Path Stroke="{StaticResource ColorUp}"
                              StrokeThickness="12"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="30,90" IsFilled="False">
                                        <ArcSegment Point="180,90"
                                                    Size="75,75"
                                                    SweepDirection="Clockwise" />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>

                        <!-- 3. DOWNLOAD: theo % Download -->
                        <Path Stroke="{StaticResource ColorDown}"
                              StrokeThickness="12"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              >
                            <Path.Data>
                                <PathGeometry>
                                    <PathFigure StartPoint="30,90" IsFilled="False">
                                        <ArcSegment Size="75,75"
                                                    SweepDirection="Clockwise"
                                                    Point="{Binding ArcDownloadPercent,
                                                            Converter={StaticResource PercentToArcEndPointConverter},
                                                            ConverterParameter='105,90,75'}" />
                                    </PathFigure>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <Grid VerticalAlignment="Stretch"
                              HorizontalAlignment="Center"
                              >
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <Viewbox Width="24"
                                         Height="24"
                                         Margin="20,20,0,0">
                                    <Path Stroke="#9AA3AE"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"
                                          Data="M5.636 19.364
                                                A9 9 0 1 1 18.364 19.364
                                                M16 9 L12 13"/> 
                                </Viewbox>

                            </StackPanel>

                        </Grid>

                        <!-- Tổng đã dùng -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding TotalUsedText}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#2B3440"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="20,70,0,0" />
                    </Grid>

                    <!-- Upload  -->
                    <Grid Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="16,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <iconPacks:PackIconFeatherIcons Kind="ArrowUp"
                                                        Width="24"
                                                        Height="24"
                                                        Foreground="{StaticResource ColorUp}"
                                                        VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding UploadTotalText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#2B3440"
                                   Margin="20,0,0,0" />

                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="20,2,0,0">
                                <TextBlock Text="{Binding UploadSpeedText}"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,0,8,0" />
                            </StackPanel>

                        </Grid>



                    </Grid>
                </Grid>

                <!-- Divider -->
                <Rectangle Grid.Column="1"
                           Width="1"
                           Fill="#E7EBF0"
                           Margin="12,10,12,8" />

                <!-- ===== Right: WAN / LAN ===== -->
                <Grid Grid.Column="2"
                      Margin="12,0,40,0"
                      VerticalAlignment="Center">       

                    <!-- 2 hàng chia đều, 3 cột dùng chung -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- WAN / LAN -->
                        <ColumnDefinition Width="120"/>
                        <!-- 183.1 MB / 132 MB -->
                        <ColumnDefinition Width="*"/>
                        <!-- thanh bar -->
                    </Grid.ColumnDefinitions>

                    <!-- ===== WAN (hàng 1) ===== -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="WAN"
                               Foreground="{StaticResource TextMuted}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding WanSizeText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#2B3440"
                               VerticalAlignment="Center"/>

                    <Border Grid.Row="0" Grid.Column="2"
                            Height="8"
                            Background="{StaticResource ColorBg}"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <Grid  Height="8" Width="600"
                              HorizontalAlignment="Left"
                              >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding WanDownPercent,
                               Converter={StaticResource PercentToStarGridLengthConverter}}"/>
                                <ColumnDefinition Width="{Binding WanUpPercent,
                               Converter={StaticResource PercentToStarGridLengthConverter}}"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource ColorDown}"
                                    CornerRadius="4,0,0,4"/>
                                            <Border Grid.Column="1"
                                    Background="{StaticResource ColorUp}"
                                    CornerRadius="0,4,4,0"/>
                        </Grid>
                    </Border>

                    <!-- ===== LAN (hàng 2) ===== -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               
                               Text="LAN"
                               Foreground="{StaticResource TextMuted}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,12,12,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding LanSizeText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#2B3440"
                               VerticalAlignment="Center"
                               Margin="0,12,12,0"/>

                    <Border Grid.Row="1" Grid.Column="2"
                            Height="8"
                            Margin="0,12,12,0"
                            Background="{StaticResource ColorBg}"
                            CornerRadius="4"
                            VerticalAlignment="Center">
                        <Grid Width="{Binding LanFillWidth}"
                              HorizontalAlignment="Left"
                              Height="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding LanDownPercent,
                               Converter={StaticResource PercentToStarGridLengthConverter}}"/>
                                <ColumnDefinition Width="{Binding LanUpPercent,
                               Converter={StaticResource PercentToStarGridLengthConverter}}"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource ColorDown}"
                                    CornerRadius="4,0,0,4"/>
                            <Border Grid.Column="1"
                                    Background="{StaticResource ColorUp}"
                                    CornerRadius="0,4,4,0"/>
                        </Grid>
                    </Border>

                </Grid>

            </Grid>
        </Border>
        <!-- TIMELINE  -->
        <Border Grid.Row="1"
                Height="30"
                Style="{StaticResource TimelineBorderStyle}"
                Margin="0"
                HorizontalAlignment="Stretch">

            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          ClipToBounds="True">
                <Canvas Width="{Binding ViewportWidth}"
                        Height="30"
                        Background="Transparent">

                    <ItemsControl ItemsSource="{Binding TimeTicks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding LabelWidth}" Height="30">
                                    <Rectangle Width="1" Height="6"
                                       Fill="#CCCCCC"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding Label}"
                                       FontSize="10"
                                       Foreground="#999999"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
