<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Footer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels.TrafficMonitor"
             xmlns:conv="clr-namespace:MonitorApp.Converters"
             xmlns:local="clr-namespace:MonitorApp.Views.Pages.TrafficMonitor.FooterParts"
             mc:Ignorable="d"
             Height="186.3">

    <UserControl.DataContext>
        <vm:TM_FooterViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:PercentToArcEndPointConverter x:Key="PercentToArcEndPointConverter" />
            <conv:PercentToStarGridLengthConverter x:Key="PercentToStarGridLengthConverter" />
            <SolidColorBrush x:Key="ColorDown" Color="#FBBF24" />
            <SolidColorBrush x:Key="ColorUp" Color="#F9A8D4" />
            <SolidColorBrush x:Key="ColorBg" Color="Transparent" />
            <SolidColorBrush x:Key="TextMuted" Color="#7C8591" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>

        <!-- ==================== TOP ==================== -->
        <Border Grid.Row="0" Style="{StaticResource FooterBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- PHẦN TRÁI ĐÃ TÁCH HOÀN TOÀN -->
                <local:TM_Footer_LeftStats Grid.Column="0" />

                <!-- Dấu phân cách -->
                <Rectangle Grid.Column="1" Width="1" Fill="#E7EBF0" Margin="12,10,12,8" />

                <!-- PHẦN PHẢI (WAN/LAN) – GIỮ NGUYÊN 100% -->
                <Grid Grid.Column="2" Margin="12,6,40,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="WAN" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding WanUsage}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="#2B3440"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="8" Background="{StaticResource ColorBg}"
                                CornerRadius="4" VerticalAlignment="Center">
                            <Grid Width="{Binding WanFillWidth}" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding DownloadRatio, Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                    <ColumnDefinition Width="{Binding UploadRatio, Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource ColorDown}" CornerRadius="4,0,0,4" />
                                <Border Grid.Column="1" Background="{StaticResource ColorUp}" CornerRadius="0,4,4,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="LAN" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LanUsage}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="#2B3440"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="8" Background="{StaticResource ColorBg}"
                                CornerRadius="4" VerticalAlignment="Center">
                            <Grid Width="{Binding LanFillWidth}" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding DownloadRatio, Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                    <ColumnDefinition Width="{Binding UploadRatio, Converter={StaticResource PercentToStarGridLengthConverter}}" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource ColorDown}" CornerRadius="4,0,0,4" />
                                <Border Grid.Column="1" Background="{StaticResource ColorUp}" CornerRadius="0,4,4,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Timeline – GIỮ NGUYÊN -->
        <Border Grid.Row="1" Style="{StaticResource TimelineBorderStyle}">
            <Grid ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding TimeLabels}"
                              Style="{StaticResource TimeLabelsStyle}">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform X="{Binding SmoothScrollOffset}" />
                    </ItemsControl.RenderTransform>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>