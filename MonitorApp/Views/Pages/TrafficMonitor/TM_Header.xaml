<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             
                xmlns:center="clr-namespace:MonitorApp.Views.Pages.TrafficMonitor.TM_Center"
                xmlns:viewmodels="clr-namespace:MonitorApp.ViewModels.PageViewModels.TrafficMonitor"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Height="auto"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- dải header mỏng -->
    <Grid  Margin="15,0,15,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Filter pill -->
        <Button Grid.Column="0"
                Style="{StaticResource HeaderButtonStyle}"
                HorizontalAlignment="Center" Margin="0,5,0,5">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="24" Height="24"
                         Margin="0,0,5,0">
                    <Canvas Width="24" Height="24">

                        <!-- Đường 1 -->
                        <Path
                            Data="M4 6H20"
                            Stroke="#666666"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Fill="Transparent" />

                        <!-- Đường 2 -->
                        <Path
                            Data="M6 12H18"
                            Stroke="#666666"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Fill="Transparent" />       

                        <!-- Đường 3 -->
                        <Path
                            Data="M9 18H15"
                            Stroke="#666666"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            Fill="Transparent" />

                    </Canvas>
                </Viewbox>

                <TextBlock Text="Filter"
                           FontSize="14"
                           FontWeight="Medium"
                           Margin="0,0,0,0"
                           Foreground="#374151"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- CENTER: viên thuốc 2 nửa (Wave / Grid) -->
        <Border Grid.Column="1"
            HorizontalAlignment="Center"
            Width="190"
            Height="35"
            CornerRadius="20"
            Background="White"
            BorderBrush="#E5EAF0"
             Margin="0,5,0,5">
            <Border.Effect>
                <DropShadowEffect Color="#666666"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- NỬA TRÁI: WAVE (mặc định chọn, nền xanh) -->
                <!-- WAVE BUTTON (LEFT) -->
                <ToggleButton Grid.Column="0"
                              Grid.RowSpan="2"
                              BorderThickness="0"
                              Command="{Binding ShowGraphCommand}"
                              IsChecked="{Binding IsGraphSelected, Mode=OneWay}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="RootBorder"
                                    Background="White"
                                    CornerRadius="20,0,0,20">
                                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <!-- SELECTED -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#60A5FA"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <!-- Icon xanh -->
                                </Trigger>

                                <!-- NOT SELECTED -->
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="RootBorder" Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <!-- Icon xám -->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>

                    <Viewbox Width="26" Height="26">
                        <Canvas Width="26" Height="26">
                            <Path
                                Data="M3 12h4.5l1.5 -6l4 12l2 -9l1.5 3h4.5"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                StrokeThickness="2"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                </ToggleButton>

                <!-- NỬA PHẢI: GRID -->
                <!-- GRID BUTTON (RIGHT) -->
                <ToggleButton Grid.Column="1"
                              Grid.RowSpan="2"
                              BorderThickness="0"
                              Command="{Binding ShowUsageCommand}"
                              IsChecked="{Binding IsUsageSelected, Mode=OneWay}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="RootBorder"
                                    Background="White"
                                    CornerRadius="0,20,20,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <!-- SELECTED -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#60A5FA"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <!-- icon xanh -->
                                </Trigger>

                                <!-- NOT SELECTED -->
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="RootBorder" Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <!-- icon xám -->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>

                    <Viewbox Width="26" Height="26">
                        <Canvas Width="26" Height="26">

                            <!-- Frame -->
                            <Path
                                Data="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                StrokeThickness="2"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent"/>

                            <!-- Divider -->
                            <Path
                                Data="M12 4L12 20"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                StrokeThickness="2"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                </ToggleButton>


            </Grid>
        </Border>

        <!-- RIGHT: expand + combo -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,5,0,5">

            <!-- ComboBox thời gian -->
            <ComboBox Style="{StaticResource RoundedComboBoxStyle}" SelectionChanged="ComboBox_SelectionChanged">
                <ComboBoxItem Content="5 Minutes" IsSelected="True"/>
                <ComboBoxItem Content="15 Minutes"/>
                <ComboBoxItem Content="30 Minutes"/>
                <ComboBoxItem Content="1 Hour"/>
                <ComboBoxItem Content="24 Hours"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>
