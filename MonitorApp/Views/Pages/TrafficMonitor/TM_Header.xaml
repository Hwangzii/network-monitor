<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F9FB">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- dải header mỏng -->
    <Grid Height="60" Margin="20,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Filter pill -->
        <Button Grid.Column="0"
                Style="{StaticResource HeaderButtonStyle}"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Path Data="M3 6h18M9 12h12M3 18h18"
                      Stroke="#666666"
                      StrokeThickness="1.8"
                      Width="16" Height="16"
                      Stretch="Uniform"
                      Margin="0,0,6,0"/>
                <TextBlock Text="Filter"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#374151"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- CENTER: viên thuốc 2 nửa (Wave / Grid+Globe) -->
        <Border Grid.Column="1"
                HorizontalAlignment="Center"
                Width="190"
                Height="40"
                CornerRadius="20"
                Background="White"
                BorderBrush="#E5EAF0"
                BorderThickness="1"
                ClipToBounds="True">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Nửa trái: Wave (đang chọn, nền xanh) -->
                <ToggleButton Grid.Column="0"
                              IsChecked="True"
                              BorderThickness="0"
                              VerticalAlignment="Stretch" Checked="ToggleButton_Checked">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>

                    <Path Data="M3 12h4l3-6 4 12 3-6h4"
                          Stroke="White"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="22" Height="22"
                          Stretch="Uniform"/>
                </ToggleButton>

                <!-- Vạch ngăn chính giữa -->
                <Border Grid.ColumnSpan="2"
                        Width="1"
                        HorizontalAlignment="Center"
                        Margin="0,6"
                        Background="#E0E4EA"/>

                <!-- Nửa phải: Grid + Globe (nền trắng) -->
                <ToggleButton Grid.Column="1"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon GRID -->
                        <Grid Grid.Column="0"
                              Width="22" Height="22"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Rectangle Width="8" Height="8"
                                       Fill="#6D7B8C"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       RadiusX="2" RadiusY="2"/>
                            <Rectangle Width="8" Height="8"
                                       Fill="#6D7B8C"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       RadiusX="2" RadiusY="2"/>
                            <Rectangle Width="8" Height="8"
                                       Fill="#6D7B8C"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       RadiusX="2" RadiusY="2"/>
                            <Rectangle Width="8" Height="8"
                                       Fill="#6D7B8C"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       RadiusX="2" RadiusY="2"/>
                        </Grid>

                    </Grid>
                </ToggleButton>
            </Grid>
        </Border>


        <!-- RIGHT: expand + combo -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">


            <!-- ComboBox thời gian -->
            <ComboBox Style="{StaticResource RoundedComboBoxStyle}">
                <ComboBoxItem Content="5 Minutes" IsSelected="True"/>
                <ComboBoxItem Content="15 Minutes"/>
                <ComboBoxItem Content="30 Minutes"/>
                <ComboBoxItem Content="1 Hour"/>
                <ComboBoxItem Content="24 Hours"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>
