<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Header"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F9FB">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- dải header mỏng -->
    <Grid Height="60" Margin="20,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Filter pill -->
        <Button Grid.Column="0"
                Style="{StaticResource HeaderButtonStyle}"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Path Data="M3 6h18M9 12h12M3 18h18"
                      Stroke="#666666"
                      StrokeThickness="1.8"
                      Width="16" Height="16"
                      Stretch="Uniform"
                      Margin="0,0,6,0"/>
                <TextBlock Text="Filter"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="#374151"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- CENTER: 2-toggle group -->
        <Border Grid.Column="1"
                Style="{StaticResource ToggleContainerStyle}"
                HorizontalAlignment="Center"
                Width="210">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Wave -->
                <ToggleButton Style="{StaticResource ViewToggleButtonStyle}"
                              IsChecked="False"
                              Margin="3,0">
                    <Path Data="M3 12h4l3-6 4 12 3-6h4"
                          Stroke="#666666"
                          StrokeThickness="2.2"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="22" Height="22"
                          Stretch="Uniform"/>
                </ToggleButton>

                <!-- Grid (đang chọn) -->
                <ToggleButton Style="{StaticResource ViewToggleButtonStyle}"
                              IsChecked="True"
                              Margin="3,0">
                    <Grid Width="22" Height="22">
                        <Rectangle Width="9" Height="9" Fill="#666666"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <Rectangle Width="9" Height="9" Fill="#666666"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Rectangle Width="9" Height="9" Fill="#666666"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <Rectangle Width="9" Height="9" Fill="#666666"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </ToggleButton>


            </StackPanel>
        </Border>

        <!-- RIGHT: expand + combo -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">


            <!-- ComboBox thời gian -->
            <ComboBox Style="{StaticResource RoundedComboBoxStyle}">
                <ComboBoxItem Content="5 Minutes" IsSelected="True"/>
                <ComboBoxItem Content="15 Minutes"/>
                <ComboBoxItem Content="30 Minutes"/>
                <ComboBoxItem Content="1 Hour"/>
                <ComboBoxItem Content="24 Hours"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>
