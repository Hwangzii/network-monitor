<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:layouts="clr-namespace:MonitorApp.Views.Pages.TrafficMonitor"
             xmlns:layouts1="clr-namespace:MonitorApp.Views.Pages.TrafficMonitor.TM_Center"
             xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels.TrafficMonitor"
             mc:Ignorable="d">

    <UserControl.DataContext>
        <vm:TM_CenterMainViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <layouts:TM_Header Grid.Row="0" DataContext="{Binding}"/>
        <!-- Center -->
        <layouts1:TM_CenterMain Grid.Row="1" DataContext="{Binding}"/>
        <!-- Footer -->
        <layouts:TM_Footer Grid.Row="2"/>
    </Grid>
</UserControl>
