<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:layouts="clr-namespace:MonitorApp.Views.Pages.TrafficMonitor"
             xmlns:layouts1="clr-namespace:MonitorApp.Views.Pages.TrafficMonitor.TM_Center"
             xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels.TrafficMonitor"
             mc:Ignorable="d"
             Background="White">
    <!-- hoặc màu nền bạn muốn -->

    <UserControl.DataContext>
        <vm:TrafficMonitorViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TM_Header: chiều cao cố định hợp lý (thường 80-100px) -->
            <RowDefinition Height="90"/>
            <!-- cố định -->
            <!-- Center: chiếm hết phần giữa, quan trọng nhất -->
            <RowDefinition Height="*"/>
            <!-- stretch hết -->
            <!-- Footer: cố định chiều cao (thường 180-220px) -->
            <RowDefinition Height="200"/>
            <!-- cố định -->
        </Grid.RowDefinitions>

        <!-- TM Header -->
        <layouts:TM_Header Grid.Row="0"
                           DataContext="{Binding HeaderViewModel}"
                           Loaded="TM_Header_Loaded" />

        <!-- Center Main (Graph + Usage) - phần quan trọng nhất -->
        <layouts1:TM_CenterMain Grid.Row="1"
                                DataContext="{Binding CenterMainViewModel}" />

        <!-- Footer -->
        <layouts:TM_Footer Grid.Row="2"
                           DataContext="{Binding FooterViewModel}" />
    </Grid>
</UserControl>