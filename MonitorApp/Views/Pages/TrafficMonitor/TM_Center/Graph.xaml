<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Center.Graph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels.TrafficMonitor"
             xmlns:conv="clr-namespace:MonitorApp.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.DataContext>
        <vm:GraphViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Converters phải có x:Key -->
            <conv:SeriesToGeometryConverter x:Key="SeriesToGeometryConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Merge styles -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Chart Area -->
        <Border Grid.Row="0" Style="{StaticResource ChartBorderStyle}">
            <Grid>

                <ScrollViewer x:Name="ChartScroller"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              ClipToBounds="True">

                    <Canvas x:Name="ChartCanvas"
                            Width="{Binding ChartWidth}"
                            MinWidth="{Binding ElementName=ChartScroller, Path=ActualWidth}"
                            Height="{Binding ElementName=ChartScroller, Path=ActualHeight}"
                            Background="Transparent">
                        <!-- CROSSHAIR (overlay) -->
                        <Line X1="{Binding HoverX}" X2="{Binding HoverX}"
                                  Y1="0" Y2="{Binding ElementName=ChartCanvas, Path=ActualHeight}"
                                  Stroke="#94A3B8" StrokeThickness="1"
                                  Visibility="{Binding IsHovering, Converter={StaticResource BoolToVis}}"/>

                        <!-- Download dot -->
                        <Ellipse Width="8" Height="8"
                                 Stroke="#FDBA21" StrokeThickness="2"
                                 Fill="#FFFFFF"
                                 Canvas.Left="{Binding HoverX}"
                                 Canvas.Top="{Binding HoverDownloadY}"
                                 Visibility="{Binding IsHovering, Converter={StaticResource BoolToVis}}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="-4" Y="-4"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Upload dot -->
                        <Ellipse Width="8" Height="8"
                                 Stroke="#F99CBF" StrokeThickness="2"
                                 Fill="#FFFFFF"
                                 Canvas.Left="{Binding HoverX}"
                                 Canvas.Top="{Binding HoverUploadY}"
                                 Visibility="{Binding IsHovering, Converter={StaticResource BoolToVis}}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="-4" Y="-4"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Upload AREA (vẽ trước) -->
                        <Path Stroke="#F99CBF"
                              StrokeThickness="2"
                              Fill="#F99CBF"
                              Opacity="0.45"
                              SnapsToDevicePixels="True">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SeriesToGeometryConverter}">
                                    <Binding Path="UploadData"/>
                                    <Binding Path="ChartWidth"/>
                                    <Binding ElementName="ChartCanvas" Path="ActualHeight"/>
                                    <Binding Path="DynamicMaxValue"/>
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- Download AREA (vẽ sau để phần overlap ngả CAM) -->
                        <Path Stroke="#FDBA21"
                              StrokeThickness="2"
                              Fill="#FDBA21"
                              Opacity="0.65"
                              SnapsToDevicePixels="True">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SeriesToGeometryConverter}">
                                    <Binding Path="DownloadData"/>
                                    <Binding Path="ChartWidth"/>
                                    <Binding ElementName="ChartCanvas" Path="ActualHeight"/>
                                    <Binding Path="DynamicMaxValue"/>
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- SELECTION overlay -->
                        <Rectangle Canvas.Left="{Binding SelectionLeft}"
                                   Canvas.Top="0"
                                   Width="{Binding SelectionWidth}"
                                   Height="{Binding ElementName=ChartCanvas, Path=ActualHeight}"
                                   Fill="#3348A3FF"
                                   Stroke="#A3B8FF"
                                   StrokeThickness="1"
                                   Visibility="{Binding IsSelectionVisible, Converter={StaticResource BoolToVis}}"/>


                    </Canvas>
                </ScrollViewer>

                <!-- Max Value -->
                <!-- Max Value -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,18,0" Padding="10,6"
                        CornerRadius="12"
                        Background="#F5F7FB" BorderBrush="#E0E4EC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding MaxLabel}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding SelectionSummary}"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"/>

                    </StackPanel>
                </Border>


            </Grid>
        </Border>

        <!-- Timeline -->
        <Border Grid.Row="1" Height="34"
                Style="{StaticResource TimelineBorderStyle}">

            <ScrollViewer x:Name="TimelineScroller"
              HorizontalScrollBarVisibility="Hidden"
              VerticalScrollBarVisibility="Hidden"
              ClipToBounds="True">
                <Canvas Width="{Binding ViewportWidth}" Height="30" Background="Transparent">

                    <ItemsControl ItemsSource="{Binding TimeTicks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- Đặt item bằng Left đã tính sẵn (center = X) -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- WIDTH cố định, tick ở giữa, text center -->
                                <Grid Width="{Binding ItemWidth}" Height="30">
                                    <Rectangle Width="1" Height="6"
                                   Fill="#CCCCCC"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"/>

                                    <TextBlock Text="{Binding Label}"
                                   FontSize="10"
                                   Foreground="#999999"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Canvas>
            </ScrollViewer>

        </Border>
    </Grid>
</UserControl>
