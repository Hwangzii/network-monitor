<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Center.Graph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels.TrafficMonitor"
             xmlns:conv="clr-namespace:MonitorApp.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.DataContext>
        <vm:GraphViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:SeriesToGeometryConverter x:Key="SeriesToGeometryConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ================= CHART AREA ================= -->
        <Border Grid.Row="0" Style="{StaticResource ChartBorderStyle}">
            <Grid>

                <!-- ===== CHART SCROLLER  ===== -->
                <ScrollViewer x:Name="ChartScroller"
                              Panel.ZIndex="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              ClipToBounds="True">

                    <Canvas x:Name="ChartCanvas"
                            Width="{Binding ChartWidth}"
                            MinWidth="{Binding ElementName=ChartScroller, Path=ActualWidth}"
                            Height="{Binding ElementName=ChartScroller, Path=ActualHeight}"
                            Background="Transparent">

                        <!-- MaxY line (fixed top) -->
                        <Line X1="0" X2="{Binding ChartWidth}"
                              Y1="0" Y2="0"
                              Stroke="#CBD5E1"
                              StrokeThickness="1"
                              StrokeDashArray="4,4"/>

                        <!-- Crosshair -->
                        <Line X1="{Binding HoverX}" X2="{Binding HoverX}"
                              Y1="0"
                              Y2="{Binding ElementName=ChartCanvas, Path=ActualHeight}"
                              Stroke="#94A3B8"
                              StrokeThickness="1"
                              Visibility="{Binding IsHovering, Converter={StaticResource BoolToVis}}"/>

                        <!-- Download dot -->
                        <Ellipse Width="8" Height="8"
                                 Stroke="#FDBA21" StrokeThickness="2"
                                 Fill="White"
                                 Canvas.Left="{Binding HoverX}"
                                 Canvas.Top="{Binding HoverDownloadY}"
                                 Visibility="{Binding IsHovering, Converter={StaticResource BoolToVis}}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="-4" Y="-4"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Upload dot -->
                        <Ellipse Width="8" Height="8"
                                 Stroke="#F99CBF" StrokeThickness="2"
                                 Fill="White"
                                 Canvas.Left="{Binding HoverX}"
                                 Canvas.Top="{Binding HoverUploadY}"
                                 Visibility="{Binding IsHovering, Converter={StaticResource BoolToVis}}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="-4" Y="-4"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Upload area -->
                        <Path Stroke="#F99CBF"
                              StrokeThickness="2"
                              Fill="#F99CBF"
                              Opacity="0.45">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SeriesToGeometryConverter}">
                                    <Binding Path="UploadData"/>
                                    <Binding Path="ChartWidth"/>
                                    <Binding ElementName="ChartCanvas" Path="ActualHeight"/>
                                    <Binding Path="DynamicMaxValue"/>
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- Download area -->
                        <Path Stroke="#FDBA21"
                              StrokeThickness="2"
                              Fill="#FDBA21"
                              Opacity="0.65">
                            <Path.Data>
                                <MultiBinding Converter="{StaticResource SeriesToGeometryConverter}">
                                    <Binding Path="DownloadData"/>
                                    <Binding Path="ChartWidth"/>
                                    <Binding ElementName="ChartCanvas" Path="ActualHeight"/>
                                    <Binding Path="DynamicMaxValue"/>
                                </MultiBinding>
                            </Path.Data>
                        </Path>

                        <!-- Selection overlay -->
                        <Rectangle Canvas.Left="{Binding SelectionLeft}"
                                   Canvas.Top="0"
                                   Width="{Binding SelectionWidth}"
                                   Height="{Binding ElementName=ChartCanvas, Path=ActualHeight}"
                                   Fill="#3348A3FF"
                                   Stroke="#A3B8FF"
                                   StrokeThickness="1"
                                   Visibility="{Binding IsSelectionVisible, Converter={StaticResource BoolToVis}}"/>
                    </Canvas>
                </ScrollViewer>

                <!-- ===== LEFT TOP: MAX SCALE + POPUP + SLIDER (TRÊN) ===== -->
                <Grid Panel.ZIndex="50"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="12,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Max label button -->
                    <Button x:Name="MaxDropBtn"
                            Padding="8,6"
                            Background="White"
                            BorderBrush="#E0E4EC"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Foreground="#64748B"
                            Click="MaxDropBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MaxLabel}" FontSize="12"/>
                            <TextBlock Text=" ▼" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Popup -->
                    <Popup x:Name="ScalePopup"
                           PlacementTarget="{Binding ElementName=MaxDropBtn}"
                           Placement="Bottom"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="White"
                                BorderBrush="#E0E4EC"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                Width="520">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsAutoScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Checked="AutoScale_CheckedChanged_ClosePopup"
                                              Unchecked="AutoScale_CheckedChanged_ClosePopup"
                                              VerticalAlignment="Center"/>

                                    <TextBlock Text="Auto-Scale"
                                               Margin="12,0,0,0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"/>
                                </StackPanel>

                                <TextBlock Margin="40,14,0,0"
                                           FontSize="14"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap">
                                    Uncheck Auto-Scale to set the desired graph scale manually.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Manual scale slider (AutoScale OFF) -->
                    <Border Grid.Row="1"
                            Margin="0,10,0,0"
                            Width="52"
                            Background="White"
                            BorderBrush="#E0E4EC"
                            HorizontalAlignment="Center"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoScale}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="140"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- top label -->
                            <TextBlock Grid.Row="0"
                                       Text="1 TB"
                                       FontSize="10"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"/>

                            <Slider Grid.Row="1"
                                    Orientation="Vertical"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding ScaleLog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Stretch"/>

                            <!-- bottom label -->
                            <TextBlock Grid.Row="2"
                                       Margin="0,6,0,6"
                                       Text="1 KB"
                                       FontSize="10"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"/>

                            <!-- AUTO OFF badge -->
                            <Border Grid.Row="2"
                                    Margin="0,26,0,0"
                                    Background="#F1F5F9"
                                    CornerRadius="6"
                                    Padding="3,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom">
                                <TextBlock FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#94A3B8"
                                           Text="AUTO&#x0a;OFF"
                                           TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                </Grid>

                <!-- RIGHT TOP INFO: chỉ hiện khi SelectionSummary có nội dung -->
                <Border Panel.ZIndex="50"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,12,18,0"
                        Padding="10,6"
                        CornerRadius="12"
                        Background="#F5F7FB"
                        BorderBrush="#E0E4EC"
                        BorderThickness="1">

                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- mặc định hiện -->
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- rỗng => ẩn -->
                                <DataTrigger Binding="{Binding SelectionSummary}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- null => ẩn -->
                                <DataTrigger Binding="{Binding SelectionSummary}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding SelectionSummary}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               TextWrapping="Wrap"
                               MaxWidth="260"/>
                </Border>


            </Grid>
        </Border>

        <!-- ================= TIMELINE ================= -->
        <Border Grid.Row="1" Height="34" Style="{StaticResource TimelineBorderStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden">
                <Canvas Width="{Binding ViewportWidth}" Height="30">
                    <ItemsControl ItemsSource="{Binding TimeTicks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding LabelWidth}" Height="30">
                                    <Rectangle Width="1" Height="6"
                                               Fill="#CCCCCC"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10"
                                               Foreground="#999999"
                                               Margin="0,10,0,0"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
