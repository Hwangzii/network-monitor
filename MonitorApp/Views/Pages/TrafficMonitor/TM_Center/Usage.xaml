<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.TM_Center.Usage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MonitorApp.ViewModels.PageViewModels.TrafficMonitor"
             xmlns:local="clr-namespace:MonitorApp.Views.Pages.TrafficMonitor.TM_Center"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:UsageViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Apps Column -->
        <Border Grid.Column="0" Style="{StaticResource UsageColumnBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Apps" Style="{StaticResource ColumnHeaderStyle}"/>

                <ScrollViewer Grid.Row="1" Style="{StaticResource UsageScrollViewerStyle}">
                    <ItemsControl ItemsSource="{Binding AppsData}" Style="{StaticResource UsageItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource UsageItemBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- content row -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0" Source="{Binding Icon}" Style="{StaticResource ItemIconStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource ItemNameStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource ItemSizeStyle}"/>
                                            <Image Grid.Column="3" Source="{Binding Flag}" Style="{StaticResource ItemFlagStyle}"/>
                                        </Grid>

                                        <!-- underline progress -->
                                        <ProgressBar Grid.Row="1"
                                                     Value="{Binding Progress}"
                                                     Style="{StaticResource UsageProgressBarStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Hosts Column -->
        <Border Grid.Column="1" Style="{StaticResource UsageColumnBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Hosts" Style="{StaticResource ColumnHeaderStyle}"/>

                <ScrollViewer Grid.Row="1" Style="{StaticResource UsageScrollViewerStyle}">
                    <ItemsControl ItemsSource="{Binding HostsData}" Style="{StaticResource UsageItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource UsageItemBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- content row -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0" Source="{Binding Flag}" Style="{StaticResource ItemFlagStyle}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Host}" Style="{StaticResource ItemNameStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource ItemSizeStyle}"/>
                                            <Image Grid.Column="3" Source="{Binding Icon}" Style="{StaticResource ItemIconStyle}" Margin="8,0,0,0"/>
                                        </Grid>

                                        <!-- underline progress -->
                                        <ProgressBar Grid.Row="1"
                                                     Value="{Binding Progress}"
                                                     Style="{StaticResource UsageProgressBarStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Traffic Type Column -->
        <Border Grid.Column="2" Style="{StaticResource UsageColumnBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Traffic Type" Style="{StaticResource ColumnHeaderStyle}"/>

                <ScrollViewer Grid.Row="1" Style="{StaticResource UsageScrollViewerStyle}">
                    <ItemsControl ItemsSource="{Binding TrafficTypeData}" Style="{StaticResource UsageItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource UsageItemBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- content row -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Type}" Style="{StaticResource ItemNameStyle}" Margin="0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource ItemSizeStyle}"/>
                                        </Grid>

                                        <!-- underline progress -->
                                        <ProgressBar Grid.Row="1"
                                                     Value="{Binding Progress}"
                                                     Style="{StaticResource UsageProgressBarStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Countries Column -->
        <Border Grid.Column="3" Style="{StaticResource UsageColumnBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Countries" Style="{StaticResource ColumnHeaderStyle}"/>

                <ScrollViewer Grid.Row="1" Style="{StaticResource UsageScrollViewerStyle}">
                    <ItemsControl ItemsSource="{Binding CountriesData}" Style="{StaticResource UsageItemsControlStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource UsageItemBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- content row -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0" Source="{Binding Flag}" Style="{StaticResource ItemFlagStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Country}" Style="{StaticResource ItemNameStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource ItemSizeStyle}"/>
                                        </Grid>

                                        <!-- underline progress -->
                                        <ProgressBar Grid.Row="1"
                                                     Value="{Binding Progress}"
                                                     Style="{StaticResource UsageProgressBarStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
