<UserControl x:Class="MonitorApp.Views.Pages.LogAnalysis"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB" Height="334">

    <!-- Styles dùng cho NavButtonStyle, BadgeStyle -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <!-- Header -->
            <RowDefinition Height="3"/>
            <!-- line xanh -->
            <RowDefinition Height="Auto"/>
            <!-- Filter + Search -->
            <RowDefinition Height="*"/>
            <!-- List log -->
            <RowDefinition Height="8"/>
            <!-- Footer xanh lá -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Logo GlassWire FREE -->
                <ColumnDefinition Width="*"/>
                <!-- Tabs -->
                <ColumnDefinition Width="Auto"/>
                <!-- English -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Nhóm / Lớp -->
            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="18,0,32,0">
                <TextBlock Text="Nhóm 5"
                           FontWeight="Bold"
                           FontSize="16"/>
                <TextBlock Text="Lớp 22CNT"
                           FontSize="12"
                           Foreground="#777777"/>
            </StackPanel>

            <!-- CENTER: TABS -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Traffic Monitor -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="Traffic&#x0a;Monitor"
                             GroupName="MainTabs">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#666666"
                                      Data="M3,18L8,8L13,18L17,11L21,18Z"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>

                <!-- GlassWire Protect -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="GlassWire&#x0a;Protect"
                             GroupName="MainTabs">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#757575"
                                      Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,16.5L8.5,13L9.91,11.59L12,13.67L15.59,10.09L17,11.5L12,16.5Z"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>

                <!-- Log Analysis (ACTIVE) -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="Log&#x0a;Analysis"
                             GroupName="MainTabs"
                             IsChecked="True">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="20" Height="20" Fill="#4C6FFF"/>
                                <Ellipse Width="10" Height="10" Fill="White"
                                         Canvas.Left="5" Canvas.Top="5"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>

                <!-- Network Scanner -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="Network&#x0a;Scanner"
                             GroupName="MainTabs">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#757575"
                                      Data="M5,11A2,2 0 1,0 5,7A2,2 0 0,0 5,11M12,13A2,2 0 1,0 12,9A2,2 0 0,0 12,13M19,17A2,2 0 1,0 19,13A2,2 0 0,0 19,17M6.5,9.5L10.5,11.5M13.5,12.5L17.5,15.5"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>
            </StackPanel>

            <!-- RIGHT: English + cờ -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0">
                <TextBlock Text="English"
                           FontSize="12"
                           Margin="0,0,6,0"/>
                <Border Width="24" Height="16"
                        Background="#DDDDDD"
                        CornerRadius="2"/>
            </StackPanel>
        </Grid>

        <!-- line xanh dưới header -->
        <Border Grid.Row="1" Background="#2F80ED"/>

        <!-- ================= FILTER + SEARCH ================= -->
        <Grid Grid.Row="2" Background="White" Height="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Important + All Time -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                <!-- Important -->
                <Border CornerRadius="16"
                        Background="#F5F7FA"
                        BorderBrush="#D1D7E0"
                        BorderThickness="1"
                        Padding="12,6"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Important"
                                   FontSize="12"
                                   Margin="0,0,4,0"/>
                        <Path Data="M4 7l4 4 4-4"
                              Stroke="#555"
                              StrokeThickness="1.5"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- All Time -->
                <Border CornerRadius="16"
                        Background="#F5F7FA"
                        BorderBrush="#D1D7E0"
                        BorderThickness="1"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All Time"
                                   FontSize="12"
                                   Margin="0,0,4,0"/>
                        <Path Data="M4 7l4 4 4-4"
                              Stroke="#555"
                              StrokeThickness="1.5"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT: Mark all as read + Search + Settings -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0">

                <!-- Mark all as read -->
                <Border CornerRadius="16"
                        Background="#F5F7FA"
                        BorderBrush="#D1D7E0"
                        BorderThickness="1"
                        Padding="16,6"
                        Margin="0,0,16,0">
                    <TextBlock Text="Mark all as read"
                               FontSize="12"/>
                </Border>

                <!-- Search box -->
                <Border CornerRadius="18"
                        Background="#F1F3F4"
                        BorderBrush="#DADCE0"
                        BorderThickness="1"
                        Height="34"
                        Width="220"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="16" Height="16"
                                Margin="12,0,6,0"
                                VerticalAlignment="Center"
                                Background="#CCCCCC"
                                CornerRadius="8"/>
                        <TextBox Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 Foreground="#555"
                                 Margin="0,0,10,0"/>
                    </Grid>
                </Border>

                <!-- Settings icon (3 thanh trượt) -->
                <Border Width="30" Height="30"
                        CornerRadius="15"
                        Background="#F5F7FA"
                        BorderBrush="#D1D7E0"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Canvas Width="18" Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Line X1="0" Y1="4" X2="18" Y2="4"
                              Stroke="#555" StrokeThickness="1.5"/>
                        <Line X1="0" Y1="9" X2="18" Y2="9"
                              Stroke="#555" StrokeThickness="1.5"/>
                        <Line X1="0" Y1="14" X2="18" Y2="14"
                              Stroke="#555" StrokeThickness="1.5"/>
                    </Canvas>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ================= LIST LOG ================= -->
        <Grid Grid.Row="3">
            <Border Background="White" Margin="0,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,8,18,0">

                        <!-- Today label -->
                        <TextBlock Text="Today"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="4,0,0,6"/>

                        <!-- ==== 1 DÒNG LOG MẪU (copy nhiều lần) ==== -->
                        <Border Background="#FFFBEF"
                                BorderBrush="#ECE3BE"
                                BorderThickness="0,1,0,0"
                                Padding="12,10"
                                Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <!-- red dot -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- NEW -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- icon app -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- text -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- right text -->
                                </Grid.ColumnDefinitions>

                                <!-- red dot -->
                                <Ellipse Grid.Column="0"
                                         Width="6" Height="6"
                                         Fill="#FF5252"
                                         VerticalAlignment="Center"/>

                                <!-- NEW badge -->
                                <Border Grid.Column="1"
                                        Margin="12,0,12,0"
                                        CornerRadius="12"
                                        Background="#34C759">
                                    <TextBlock Text="NEW"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Padding="8,2"/>
                                </Border>

                                <!-- app icon (window) -->
                                <Border Grid.Column="2"
                                        Width="18" Height="18"
                                        BorderBrush="#555"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0">
                                    <Rectangle Margin="3,3,3,3"
                                               Stroke="#555"
                                               StrokeThickness="1"/>
                                </Border>

                                <!-- message -->
                                <TextBlock Grid.Column="3"
                                           Text="Git for Windows initiated its first network connection to 🇺🇸 github.com"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- right text -->
                                <StackPanel Grid.Column="4"
                                            Orientation="Vertical"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="First network activity"
                                               FontSize="12"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="9:15 am"
                                               FontSize="11"
                                               Foreground="#666"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- copy Border trên nhiều lần để có list dài -->

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER XANH LÁ -->
        <Border Grid.Row="4" Background="#E0FFB3"/>
    </Grid>
</UserControl>
