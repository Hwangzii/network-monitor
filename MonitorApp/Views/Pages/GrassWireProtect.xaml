<UserControl x:Class="MonitorApp.Views.Pages.TrafficMonitor.GrassWireProtect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">

    <!-- Styles dùng cho NavButtonStyle, BadgeStyle -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>   <!-- Header -->
            <RowDefinition Height="3"/>    <!-- line xanh dưới header -->
            <RowDefinition Height="Auto"/> <!-- Search -->
            <RowDefinition Height="*"/>    <!-- Active Apps -->
            <RowDefinition Height="8"/>    <!-- Footer xanh lá -->
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- Logo GlassWire FREE -->
                <ColumnDefinition Width="*"/>     <!-- Tabs -->
                <ColumnDefinition Width="Auto"/>  <!-- Text phải -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: GlassWire FREE -->
            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Margin="18,0,32,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NHÓM 5"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>
                    <Path Data="M4 7l4 4 4-4"
                          Stroke="#777777"
                          StrokeThickness="1.5"
                          Stretch="Uniform"
                          Width="10" Height="10"
                          Margin="4,2,0,0"/>
                </StackPanel>
                <TextBlock Text="Lớp 22CN1"
                           FontSize="11"
                           Foreground="#B0B0B0"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- CENTER: TABS -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Traffic Monitor -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="Traffic&#x0a;Monitor"
                             GroupName="MainTabs">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#666666"
                                      Data="M3,18L8,8L13,18L17,11L21,18Z"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>

                <!-- GlassWire Protect (đang chọn) -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="GlassWire&#x0a;Protect"
                             GroupName="MainTabs"
                             IsChecked="True">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#757575"
                                      Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,16.5L8.5,13L9.91,11.59L12,13.67L15.59,10.09L17,11.5L12,16.5Z"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>

                <!-- Log Analysis -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="Log&#x0a;Analysis"
                             GroupName="MainTabs">
                    <RadioButton.Tag>
                        <Grid>
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#757575"
                                          Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M11,6H13V13H11V6M11,15H13V17H11V15Z"/>
                                </Canvas>
                            </Viewbox>
                            <Border Style="{StaticResource BadgeStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                <TextBlock Text="9+"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </RadioButton.Tag>
                </RadioButton>

                <!-- Network Scanner -->
                <RadioButton Style="{StaticResource NavButtonStyle}"
                             Content="Network&#x0a;Scanner"
                             GroupName="MainTabs">
                    <RadioButton.Tag>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#757575"
                                      Data="M5,11A2,2 0 1,0 5,7A2,2 0 0,0 5,11M12,13A2,2 0 1,0 12,9A2,2 0 0,0 12,13M19,17A2,2 0 1,0 19,13A2,2 0 0,0 19,17M6.5,9.5L10.5,11.5M13.5,12.5L17.5,15.5"/>
                            </Canvas>
                        </Viewbox>
                    </RadioButton.Tag>
                </RadioButton>
            </StackPanel>

            <!-- RIGHT -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0">
                <TextBlock Text="Get All Premium&#x0a;Features"
                           FontSize="11"
                           Foreground="#9E9E9E"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
            </StackPanel>
        </Grid>

        <!-- line xanh dưới header -->
        <Border Grid.Row="1" Background="#2F80ED"/>

        <!-- ==================== SEARCH ==================== -->
        <Grid Grid.Row="2" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="600"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Search"
                           FontSize="14"
                           Margin="0,0,0,6"
                           HorizontalAlignment="Center"/>
                <Border Background="#F1F3F4"
                        CornerRadius="20"
                        Height="40"
                        BorderBrush="#DADCE0"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="18" Height="18"
                                Margin="16,0,8,0"
                                VerticalAlignment="Center"
                                Background="#CCCCCC"
                                CornerRadius="9"/>
                        <TextBox Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="0,0,16,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Foreground="#555555"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>


        <!-- ==================== ACTIVE APPS ==================== -->
        <Grid Grid.Row="3" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Active Apps -->
                <RowDefinition Height="*"/>   <!-- bảng -->
            </Grid.RowDefinitions>

            <!-- tiêu đề -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="8,4,0,4"
                        VerticalAlignment="Center">
                <TextBlock Text="▾"
                           FontSize="12"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Active Apps"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- bảng chính -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E1E4EA"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- HEADER CỘT -->
                        <Grid Background="#F5F7FA" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1" Text="Apps" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="In Connections"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Out Connections"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Version"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Hosts"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="VirusTotal"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="↑"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#B0B0B0"/>
                            <TextBlock Grid.Column="8" Text="↓"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#B0B0B0"/>
                        </Grid>

                        <!-- ===== 1 DÒNG MẪU (copy thêm để có nhiều dòng) ===== -->
                        <Grid Height="32" Background="White">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <!-- expand -->
                            <TextBlock Grid.Column="0"
                                       Text="▸"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#999999"/>

                            <!-- Apps -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="4,0"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                    <Rectangle Width="12" Height="12"
                                               Stroke="#444" StrokeThickness="1"/>
                                    <Rectangle Width="6" Height="10"
                                               Stroke="#444" StrokeThickness="1"
                                               Margin="-6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Host Process for Windows Services"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- In Connections -->
                            <Border Grid.Column="2"
                                    CornerRadius="4"
                                    Padding="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#EAF8ED"
                                    BorderBrush="#8BC34A"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Allowed"
                                               Foreground="#2E7D32"
                                               FontSize="11"
                                               Margin="0,0,4,0"/>
                                    <Path Data="M 0 0 L 6 0 L 3 4 Z"
                                          Fill="#2E7D32"
                                          Width="6" Height="4"
                                          VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Out Connections -->
                            <Border Grid.Column="3"
                                    CornerRadius="4"
                                    Padding="10,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#FDEAEA"
                                    BorderBrush="#E57373"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Blocked"
                                               Foreground="#C62828"
                                               FontSize="11"
                                               Margin="0,0,4,0"/>
                                    <Path Data="M 0 0 L 6 0 L 3 4 Z"
                                          Fill="#C62828"
                                          Width="6" Height="4"
                                          VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Version -->
                            <TextBlock Grid.Column="4"
                                       Text="10.0.26100.50..."
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="11"/>

                            <!-- Hosts -->
                            <StackPanel Grid.Column="5"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Rectangle Width="16" Height="11"
                                           Fill="#DDDDDD"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="tr0dcentrialind...   +39 more"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- VirusTotal -->
                            <StackPanel Grid.Column="6"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="2 KB/s"
                                           FontSize="11"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="71 KB/s"
                                           FontSize="11"
                                           Margin="0,0,6,0"/>
                                <Polygon Points="0,12 10,12 5,2"
                                         Fill="#FFC107"/>
                            </StackPanel>
                        </Grid>

                        <!-- copy Grid ở trên thêm nhiều lần để có list dài -->

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <!-- FOOTER XANH LÁ -->
        <Border Grid.Row="4" Background="#E0FFB3"/>
    </Grid>
</UserControl>
