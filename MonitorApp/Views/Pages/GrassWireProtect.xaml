<UserControl x:Class="MonitorApp.Views.Pages.GrassWireProtect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="900">

    <!-- Chỉ merge style từ file ngoài vào -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- nếu bạn đặt tên khác / thư mục khác thì sửa lại đường dẫn này -->
                <ResourceDictionary Source="/MonitorApp;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== TOP TOOLBAR ===== -->
        <Border Background="#FFFFFF" Padding="20" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Firewall -->
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Firewall" FontSize="14" Foreground="#475569" Margin="0,0,0,4"/>
                    <ToggleButton Width="60" Height="28" Background="#CBD5E1" BorderBrush="#CBD5E1">
                        <TextBlock Text="OFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                </StackPanel>

                <!-- Firewall Profile -->
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left">
                    <TextBlock Text="Firewall Profile" FontSize="14" Foreground="#475569" Margin="0,0,0,4"/>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="Create New Profile" Foreground="#1E293B"/>
                    </Border>
                </StackPanel>

                <!-- Firewall Mode -->
                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Left">
                    <TextBlock Text="Firewall Mode" FontSize="14" Foreground="#475569" Margin="0,0,0,4"/>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6">
                        <TextBlock Text="Click To Block" Foreground="#1E293B"/>
                    </Border>
                </StackPanel>

                <!-- Search -->
                <StackPanel Grid.Column="3" Orientation="Vertical">
                    <TextBlock Text="Search" FontSize="14" Foreground="#475569" Margin="0,0,0,4"/>
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <TextBox Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#1E293B"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TABLE HEADER ===== -->
        <Border Grid.Row="1" Background="{StaticResource HeaderBg}" Padding="16,10"
                BorderBrush="{StaticResource BorderGray}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Active Apps" Grid.Column="0" FontWeight="Bold"
                           Foreground="{StaticResource TextDark}"/>
                <TextBlock Text="In Connections" Grid.Column="1"
                           Foreground="{StaticResource TextLight}"/>
                <TextBlock Text="Out Connections" Grid.Column="2"
                           Foreground="{StaticResource TextLight}"/>
                <TextBlock Text="Version" Grid.Column="3"
                           Foreground="{StaticResource TextLight}"/>
                <TextBlock Text="Hosts" Grid.Column="4"
                           Foreground="{StaticResource TextLight}"/>
                <TextBlock Text="VirusTotal" Grid.Column="5"
                           Foreground="{StaticResource TextLight}"/>
            </Grid>
        </Border>

        <!-- ===== TABLE ROWS (demo 3 dòng) ===== -->
        <StackPanel Grid.Row="1" Margin="0,50,0,0">

            <!-- Row 1 -->
            <Border Background="{StaticResource RowBg}" Padding="16,10"
                    BorderBrush="{StaticResource BorderGray}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Microsoft Software Protection Platform"
                               Grid.Column="0" Foreground="{StaticResource TextDark}"/>

                    <Border Grid.Column="1" Style="{StaticResource TagAllowed}">
                        <TextBlock Text="Allowed" Foreground="#15803D" FontSize="12"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource TagAllowed}">
                        <TextBlock Text="Allowed" Foreground="#15803D" FontSize="12"/>
                    </Border>

                    <TextBlock Grid.Column="3" Text="10.0.26100.71"
                               Foreground="{StaticResource TextDark}"/>
                    <TextBlock Grid.Column="4" Text="-" Foreground="{StaticResource TextLight}"/>
                </Grid>
            </Border>

            <!-- Row 2 -->
            <Border Background="{StaticResource RowAltBg}" Padding="16,10"
                    BorderBrush="{StaticResource BorderGray}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Node.js JavaScript Runtime"
                               Grid.Column="0" Foreground="{StaticResource TextDark}"/>

                    <Border Grid.Column="1" Style="{StaticResource TagBlocked}">
                        <TextBlock Text="Blocked" Foreground="#B91C1C" FontSize="12"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource TagAllowed}">
                        <TextBlock Text="Allowed" Foreground="#15803D" FontSize="12"/>
                    </Border>

                    <TextBlock Grid.Column="3" Text="22.17.1"
                               Foreground="{StaticResource TextDark}"/>
                    <TextBlock Grid.Column="4" Text="-" Foreground="{StaticResource TextLight}"/>
                    <TextBlock Grid.Column="5" Text="⚠" Foreground="#F59E0B"/>
                </Grid>
            </Border>

            <!-- Row 3 -->
            <Border Background="{StaticResource RowBg}" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="PDF Reader"
                               Grid.Column="0" Foreground="{StaticResource TextDark}"/>

                    <Border Grid.Column="1" Style="{StaticResource TagAllowed}">
                        <TextBlock Text="Allowed" Foreground="#15803D" FontSize="12"/>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource TagAllowed}">
                        <TextBlock Text="Allowed" Foreground="#15803D" FontSize="12"/>
                    </Border>

                    <TextBlock Grid.Column="3" Text="2025.7.25"
                               Foreground="{StaticResource TextDark}"/>
                </Grid>
            </Border>

        </StackPanel>

    </Grid>

</UserControl>
